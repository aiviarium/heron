// The spec language.specifications.implementations.sealed_spec_example
// shows, installed where its implementation_example's git import finds it.
import = ["std/schema@1", "std/doc@1", "std/spec@1"]

shop: package(version = "0.2.0", sealed = true) {
  shopper: actor {{ Someone who buys from the shop. }}

  checkout: section {
    @by(shopper)
    @targets(checkout)
    totals: rule {
      must {{ see the order's total before paying }}
    }
  }
}
