import = [
  "std/doc@1",
  "std/types@1",
  "std/spec@1",
  "std/ci@1",
  "std/scenarios@1",
  "std/process@1",
  "std/json@1",
]

include = [
  "./projects.heron",
  "./changelog.heron",
  "./specs/store/index.heron",
  "./ci.heron",
  "./services/store/tasks.heron",
  "./infra/resources.heron",
  "./agents/index.heron",
]

repository {
  toolchain = { node = "22", pnpm = "9" }

  setup: task do {
    run("pnpm", args = ["install"])
    generate()
  }
}

development {
  work: stage<local, rebase>(branch = "agent/%slug%") {
    requires = [checks.lint, checks.unit]
  }

  integration: stage<protected, squash>(branch = "develop") {
    requires = [checks.unit, checks.e2e]
  }

  staging: stage<protected, strict, merge>(branch = "staging") {
    requires = [checks.unit, checks.e2e]
    secrets = [env("STAGING_DEPLOY_TOKEN")]

    deploy: task do {
      run("./deploy.sh", args = ["staging"])
    }
  }

  production: stage<protected, strict, merge>(branch = "main") {
    requires = [checks.unit, checks.e2e]
    gates = [approval(owners = 1)]
    secrets = [env("PROD_DEPLOY_TOKEN")]

    @undo(rollback)
    deploy: task do {
      run("./deploy.sh", args = ["production"])
    }

    rollback: task<confirm> do {
      run("./deploy.sh", args = ["rollback"])
    }
  }
}

include = ["./settings.heron"]
