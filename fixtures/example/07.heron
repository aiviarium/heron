release(project = petstore, version = "4.2.0", date = "2026-11-22") {
  members = { store_spec = "2.1.0", store_svc = "1.5.0", shared_types = "3.0.2" }
}

release(project = store_svc, version = "1.5.0", date = "2026-11-22") {
  implements = { store_spec = "2.1.0" }

  feat {{
    Orders for pets that aren't available are rejected, as
    [the availability rule](#ordering.only_available) requires.
  }}
  fix {{ Cancelling an order puts the pet back on sale instead of leaving it pending. }}
}

release(project = store_spec, version = "2.1.0", date = "2026-11-20") {
  feat {{ Adds [the availability rule](#ordering.only_available). }}
}
