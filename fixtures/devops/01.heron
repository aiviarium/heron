import = ["std/ci@1"]

checks: pipeline {
  lint: phase do {
    lint()
  }

  @needs(lint)
  unit: phase<default, fail_fast>

  @needs(unit)
  e2e: phase<speculative>

  @needs<always>(unit, e2e)
  report: phase do {
    publish_report()
  }

  include = ["./payments/", "./shared/"]
}

