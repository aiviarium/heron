// index.heron
import = ["std/ci@1"]
include = ["./payments/", "./shared/"]

repository {
  toolchain = { node = "22", pnpm = "9" }

  setup: task do {
    run("pnpm", args = ["install"])
    generate()
  }
}

// Projects are declared with the spec; DevOps adds their tasks.
payments_svc.{
  build: task do {
    run("pnpm", args = ["--filter", "payments", "build"])
  }

  test: task do {
    run("pnpm", args = ["--filter", "payments", "test"])
  }

  lint: task do {
    run("pnpm", args = ["--filter", "payments", "lint"])
  }
}

development {
  work: stage<local, rebase>(branch = "agent/%slug%") {
    requires = [checks.lint, checks.unit]
  }

  integration: stage<protected, squash>(branch = "develop") {
    requires = [checks.unit, checks.e2e]
  }

  staging: stage<protected, strict, merge>(branch = "staging") {
    requires = [checks.unit, checks.e2e]

    deploy: task do {
      run("./deploy.sh", args = ["staging"])
    }
  }

  production: stage<protected, strict, merge>(branch = "main") {
    requires = [checks.unit, checks.e2e]
    gates = [approval(owners = 1)]

    @undo(rollback)
    deploy: task do {
      run("./deploy.sh", args = ["production"])
    }

    rollback: task<confirm> do {
      run("./deploy.sh", args = ["rollback"])
    }
  }
}

include = ["./settings.heron"]

// settings.heron: the tunables, amended by path
development.work.max_open = 3
development.work.selection.speculative = true
development.work.selection.budget = 20000

development.integration.selection.speculative = true
development.integration.selection.budget = 60000

development.{
  commits.{
    format = ConventionalCommits(
      types = ["feat", "fix", "refactor", "test", "docs", "spec", "chore"],
    )
    granularity = PerBehaviour()
    attribution = CoAuthoredAttribution()
    subject_max = 72
    spec_refs = true

    guidance =| The body says why the change was needed, not what the diff already shows.
  }
}

// The root project is declared with the spec; settings say how versions move.
acme.versioning.{
  bumps = FromCommits(breaking = "major", feat = "minor", fix = "patch")
  channels = { integration = "beta", staging = "rc" }
  tag = "%project%@%version%"
}

// The shared types are published on their own.
shared_types.versioning.{
  tag = "types/v%version%"
}

develop.{
  test_first = true
}
