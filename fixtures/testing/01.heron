import = ["std/types@1", "std/scenarios@1"]
include = ["./infra.heron"]

// infra.heron declares PaymentsStore: type(Snapshot) { … },
// start_store(): func(PaymentsStore) and start_payments(db: PaymentsStore): func(Server).

@gas(300)
store: resource(PaymentsStore) {
  setup do {
    return start_store(migrations = "./migrations")
  }
}

// Same software, different setup: a distinct resource, not a change to store.
@gas(340)
captured_store: resource(PaymentsStore) {
  setup do {
    return start_store(
      migrations = "./migrations",
      seed = "./seeds/captured.json",
    )
  }

  // Runs after setup and after every mutation. Without it, the store is recreated.
  reset do {
    captured_store.restore_seed("./seeds/captured.json")
  }
}

// An api only declares the contract. A running instance of it is a resource
// whose setup returns a client for it; the api's examples check it after setup.
payments_service: resource(payments) {
  setup do {
    let server = start_payments(db = captured_store)
    return payments.client(base = server.url)
  }
}

card_sandbox: resource<exclusive>(Sandbox) {
  setup do {
    return Sandbox.lease()
  }
}
