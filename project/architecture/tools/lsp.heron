@display("LSP")
@realizes(heron.product.system.language_server)
lsp: component("internal/tools/lsp", lang = "go") {
  | The language server as a library: one [session](#heron.tools.lsp.session.lsp_session) per client, served over
  | standard input and output by `heron lsp` and over the `/lsp` socket by [the server](#architecture.tools.server). It answers from the
  | same checked tree as `heron check` and `heron lint`, so an editor never disagrees with
  | them.

  uses = [architecture.runtime.check, architecture.runtime.diag, architecture.runtime.format, architecture.runtime.lint, architecture.runtime.registry, architecture.runtime.resolve, architecture.runtime.syntax, architecture.runtime.types, architecture.tools.prose, architecture.runtime.std]

  sessions: responsibility {{ Keep one analysis per client over the open documents, and publish every file's diagnostics after a change. }}
  features: responsibility {{ Answer the language features below from the checked tree. }}
  protocol: responsibility {{ Read and write JSON-RPC messages, framed with `Content-Length` headers on a stream. }}

  /// A connection that carries whole JSON-RPC messages, one per call.
  surface(title = "conn.go") {{
    type Conn interface {
      ReadMessage() ([]byte, error)
      WriteMessage([]byte) error
    }
    func StreamConn(rw io.ReadWriter) Conn
  }}

  /// A session over a connection, and the shortcut for standard input and output.
  surface(title = "session.go") {{
    type Options struct {
      Registry *registry.Registry
      Dir      string
      Debounce time.Duration
      Log      io.Writer
    }
    func NewSession(c Conn, o Options) *Session
    func (s *Session) Run(ctx context.Context) error
    func Serve(ctx context.Context, rw io.ReadWriter, o Options) error
  }}

  /// Installs `heron lsp`.
  surface(title = "command.go") {{
    func Register(r *registry.Registry)
  }}

  raises("-32002") {{ A request other than `initialize` before the session is initialized: "the server isn't initialized". }}
  raises("-32601") {{ A request with no handler: "no method ‹method›". }}
  raises("-32602") {{ Invalid parameters, a rename the [rename rules](#heron.tools.lsp.rename) refuse, or a command that fails. }}
  raises("-32603") {{ A handler that panics: "internal error in ‹method›: ‹reason›"; the session goes on. }}

  obligation(path = "internal/tools/lsp/lsp_test.go") {{ Open every file of the sample repository and of spec/ with no diagnostic, whatever the URI spelling and the order. }}
  obligation(path = "scripts/e2e-lsp.sh") {{ Drive `heron lsp` over stdio on a copy of the sample repository with a scripted client. }}

  same_answers: invariant {
    must {{ report for every file the diagnostics `heron check` and `heron lint` report for its tree, with nothing added or missed }}
    verify("internal/tools/lsp/lsp_test.go", test = "TestOpenEveryFileWithoutFalseDiagnostics")
  }

  latest_text: invariant {
    must {{ answer every request after rechecking the open documents if anything changed, so an answer reflects the latest text }}
    verify("internal/tools/lsp/lsp_test.go", test = "TestErrorsAppearClearAndReachImporters")
  }

  verify("scripts/e2e-lsp.sh") {{ [heron lsp](#heron.cli.lsp) over stdio. }}
  verify("scripts/e2e-app.sh", test = "lsp") {{ [Unit](#delivery.units) 2's [done criterion](#delivery.unit_2) for the language server: diagnostics, completion, hover, go to definition and rename in an editor. }}
}
