@display("LSP")
lsp: component("internal/tools/lsp", heron.system.language_server, lang = "go") {
  | The language server as a library: one [session](#heron.tools.lsp.session.lsp_session) per client, served over
  | standard input and output by `heron lsp`. It answers from the
  | same checked tree as `heron check` and `heron lint`, so an editor never disagrees with
  | them.

  uses = [architecture.runtime.check, architecture.runtime.diag, architecture.runtime.format, architecture.runtime.lint, architecture.runtime.registry, architecture.runtime.resolve, architecture.runtime.syntax, architecture.runtime.types, architecture.tools.prose, architecture.runtime.std, architecture.tools.docs]

  sessions: responsibility {{ Keep one analysis per client over the open documents, and publish every file's diagnostics after a change. }}
  features: responsibility {{ Answer the language features below from the checked tree, and `heron/preview` through the docs renderer. }}
  protocol: responsibility {{ Read and write JSON-RPC messages, framed with `Content-Length` headers on a stream. }}

  /// A connection that carries whole JSON-RPC messages, one per call.
  exports(title = "conn.go") {{
    type Conn interface {
      ReadMessage() ([]byte, error)
      WriteMessage([]byte) error
    }
    func StreamConn(rw io.ReadWriter) Conn
  }}

  /// A session over a connection, and the shortcut for standard input and output.
  exports(title = "session.go") {{
    type Options struct {
      Registry *registry.Registry
      Dir      string
      Debounce time.Duration
      Log      io.Writer
    }
    func NewSession(c Conn, o Options) *Session
    func (s *Session) Run(ctx context.Context) error
    func Serve(ctx context.Context, rw io.ReadWriter, o Options) error
  }}

  /// Installs `heron lsp`.
  exports(title = "command.go") {{
    func Register(r *registry.Registry)
  }}

  responsibility {{ Returns the error -32002: A request other than `initialize` before the session is initialized: "the server isn't initialized". }}
  responsibility {{ Returns the error -32601: A request with no handler: "no method ‹method›". }}
  responsibility {{ Returns the error -32602: Invalid parameters, a rename the [rename rules](#heron.tools.lsp.rename) refuse, or a command that fails. }}
  responsibility {{ Returns the error -32603: A handler that panics: "internal error in ‹method›: ‹reason›"; the session goes on. }}

  property() {

    | Open every file of the sample repository and of spec/ with no diagnostic, whatever the URI spelling and the order.

    verify("internal/tools/lsp/lsp_test.go")

  }
  property() {
    | Drive `heron lsp` over stdio on a copy of the sample repository with a scripted client.
    verify("scripts/e2e-lsp.sh")
  }

  same_answers: property {
    must {{ report for every file the diagnostics `heron check` and `heron lint` report for its tree, with nothing added or missed }}
    verify("internal/tools/lsp/lsp_test.go", test = "TestOpenEveryFileWithoutFalseDiagnostics")
  }

  latest_text: property {
    must {{ answer every request after rechecking the open documents if anything changed, so an answer reflects the latest text }}
    verify("internal/tools/lsp/lsp_test.go", test = "TestErrorsAppearClearAndReachImporters")
  }

  verify("scripts/e2e-lsp.sh") {{ [heron lsp](#heron.cli.lsp) over stdio. }}
  verify("editors/vscode/test/e2e/suite.ts") {{ [Unit](#delivery.units) 2's [done criterion](#delivery.unit_2) for the language server: diagnostics, completion and hover in VS Code. }}
}
