server: component("internal/tools/server", heron.system.server, lang = "go") {
  | The shell of `heron serve`: it serves the frontend, the spec browser, the editor's
  | language server socket and the API on one address, and [mounts](#heron.language.core_format.mounts.mount) the ops other [units](#delivery.units)
  | declare. The built frontend is embedded, so everything still ships in one binary.

  uses = [architecture.runtime.check, architecture.runtime.diag, architecture.runtime.gen, architecture.runtime.lint, architecture.runtime.records, architecture.runtime.registry, architecture.runtime.resolve, architecture.tools.docs, architecture.tools.lsp, architecture.tools.server_api, architecture.tools.server_route]

  shell: responsibility {{ Route each request to the base API, a mounted extension, the spec browser, the `/lsp` socket or the frontend. }}
  workspace: responsibility {{ One check session over the served tree, shared by every request, so analysis stays incremental across edits. }}
  base_ops: responsibility {{ Implement the base API's ops: the workspace, files, problems, the outline, the preview, results, records, task runs and generated files. }}

  /// The shell and the extensions `Mount` adds to it.
  exports(title = "server.go") {{
    type Shell struct {
      LSP      LSP
      Renderer Renderer
      Frontend fs.FS
    }
    type Extension struct {
      Name    string
      Routes  []route.Route
      Results []Results
    }
    func Register(r *registry.Registry) *Shell
    func (s *Shell) Mount(e Extension) error
    func (s *Shell) Handler(w *Workspace) (http.Handler, error)
    func OpenWorkspace(entry string, r *registry.Registry) (*Workspace, error)
  }}

  property() {

    | Serve the base ops, the spec browser, a sample extension's routes and the socket from a real shell.

    verify("internal/tools/server/server_test.go")

  }

  one_binary: property {
    must {{ embed the built frontend, so `heron serve` needs nothing beside the binary }}
    verify("internal/tools/server/server_test.go", test = "TestFrontendFallsBackToIndex")
  }

  verify("scripts/e2e-app.sh") {{ [heron serve](#heron.cli.serve) with the editor in Chromium. }}
}

server_api: component("internal/tools/server/api", heron.system.server, lang = "go") {
  | The Go handlers of [the server API](#heron.tools.server_api.spec_server), which the spec package
  | publishes with its types and errors: `apigen` reads it from the spec package and writes
  | `api_gen.go` here and the TS client of `web/shell`. A later [unit](#delivery.units) adds its
  | ops by entering `spec_server` from its own files, as the sample under
  | `internal/tools/server/internal/sample` does.

  uses = [architecture.tools.server_route]

  generated_current: property {
    must {{ keep the committed `api_gen.go` and `web/shell/src/api.gen.ts` equal to what [the API generator](#architecture.tools.server_apigen) writes from the [Heron files](#heron.language.core_format.files.heron_file) }}
    verify("internal/tools/server/server_test.go", test = "TestGeneratedRoutesMatchTheHeron")
  }

  no_hand_written_requests: property {
    must {{ give the frontend every request type and call through the generated client, with none written by hand }}
    verify("internal/tools/server/server_test.go", test = "TestGeneratedRoutesMatchTheHeron")
  }
}

@display("API generator")
server_apigen: component("internal/tools/server/apigen", heron.system.server, lang = "go") {
  | Writes a [unit](#delivery.units)'s routes and client from its ops on `spec_server`:
  | `go run ./internal/tools/server/apigen -base server.heron [-ext files] -go out.go -pkg name -ts out.ts`.

  uses = [architecture.runtime.check, architecture.runtime.resolve, architecture.runtime.types]

  only_own_ops: property {
    must {{ check `spec_server` with the `-ext` files included, and write for their ops only, or for the base's when no `-ext` is given: Go types, a `Service` interface, `Routes(Service)`, and a TS client }}
    verify("internal/tools/server/server_test.go", test = "TestExtensionRoutesAreMounted")
  }
}

server_route: component("internal/tools/server/route", heron.system.server, lang = "go") {
  | What generated API code and the server shell share.

  uses = []

  /// A route, its errors and its streams.
  exports(title = "route.go") {{
    type Route struct {
      Op, Method, Path string
      Stream, Socket   bool
      Handler          http.HandlerFunc
    }
    func (r Route) Pattern() string
    func Errorf(status int, format string, args ...any) error
    func WriteJSON(w http.ResponseWriter, v any)
    func WriteError(w http.ResponseWriter, err error)
    func DecodeBody(r *http.Request, v any) error
    func NewEvents(w http.ResponseWriter) *Events
  }}

  errors_as_json: property {
    must {{ write an error as `{"error": "‹message›"}` with its status, 500 when it carries none, and a body that isn't JSON as 400 "invalid body: ‹reason›" }}
    verify("internal/tools/server/server_test.go", test = "TestBaseOps")
  }

  stream_errors: property {
    must {{ end a stream that fails before its first event with an error response, and one that fails later with an `error` event }}
    verify("internal/tools/server/server_test.go", test = "TestBaseOps")
  }
}
