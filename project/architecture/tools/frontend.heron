frontend: section {
  | The pnpm workspace under `web/`, one component each: TypeScript with Solid 2, built
  | with Vite around one shared component package.

  tokens: component("web/tokens", heron.system.editor, heron.system.docs_generator, lang = "ts") {
    | The design tokens, declared once in `tokens.json` and generated to CSS, TS and Go, as
    | [the design system](#heron.tools.frontend.design_system) says.

    uses = []

    property() {

      | Keep the generated files current, and check contrast, neutral [surfaces](#heron.tools.frontend.design_system.surfaces) and the scales.

      verify("web/tokens/tokens_test.go")

    }
  }

  strings: component("web/strings", heron.system.editor, heron.system.docs_generator, lang = "ts") {
    | The catalogue of every string the tools show that doesn't come from a spec, in
    | `strings.json`, keyed `<tool>.<group>.<name>`: the docs renderer reads `docs.*`, its
    | islands `docs.island.*` through `data.js`, and the app `app.*`. Go reads it through the
    | package `uistrings`.

    uses = []

    one_catalogue: property {
      must {{ hold every string the docs renderer, its islands and the app show that doesn't come from a spec }}
      verify("internal/tools/docs/docs_test.go", test = "TestVisibleTextComesFromSpecOrCatalogue")
    }
  }

  components: component("web/components", heron.system.editor, heron.system.docs_generator, lang = "ts") {
    | The shared components the app and the docs' islands compose from the [UI SDK](#heron.tools.frontend.design_system.ui_sdk): buttons, icon
    | buttons, keys, the file tree, lists, tabs and the palette, styled from the tokens.

    uses = [architecture.tools.frontend.tokens, architecture.tools.frontend.strings]
  }

  editor_package: component("web/editor", heron.system.editor, lang = "ts") {
    | Monaco set up for Heron, the language client over the `/lsp` socket, the models of the
    | open files, the language features and the preview, as [the code editor](#heron.tools.frontend.editor) specifies.

    uses = [architecture.tools.frontend.tokens, architecture.tools.frontend.strings, architecture.tools.frontend.components]
  }

  shell_package: component("web/shell", heron.system.editor, lang = "ts") {
    | The app `heron serve` embeds: the [editor screen](#heron.tools.frontend.screens.editor_screen), its state, the generated API client
    | and the [slots](#heron.tools.frontend.shell) its parts add their views through.

    uses = [architecture.tools.frontend.tokens, architecture.tools.frontend.strings, architecture.tools.frontend.components, architecture.tools.frontend.editor_package]

    property() {

      | The editor's acceptance tests: Playwright drives Chromium against the real `heron serve` on fresh copies of the sample repository.

      verify("scripts/e2e-app.sh")

    }
  }

  docs_islands: component("web/docs", heron.system.docs_generator, lang = "ts") {
    | The docs' built-in theme and [islands](#heron.tools.docs.islands), built once into `internal/tools/docs/assets` and embedded.

    uses = [architecture.tools.frontend.tokens, architecture.tools.frontend.strings, architecture.tools.frontend.components]

    assets_current: property {
      must {{ keep the committed `docs.js` and `docs.css` equal to the build of `web/docs` }}
      verify("scripts/ci.sh")
    }
  }
}
