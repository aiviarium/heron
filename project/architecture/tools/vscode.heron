@display("VS Code extension")
vscode: component("editors/vscode", heron.system.editor_extension, heron.tools.vscode, lang = "ts") {
  | The [VS Code extension](#heron.tools.vscode), in TypeScript, bundled by esbuild into
  | `dist/extension.js` for the desktop and `dist/web.js` for the browser and packaged by
  | `@vscode/vsce` as `heron.vsix`. Its language client is `vscode-languageclient` over
  | [heron lsp](#heron.cli.lsp); its grammars are the [TextMate grammars](#heron.tools.tree_sitter.textmate) that
  | `internal/tools/textmate` publishes under `grammar/textmate`, copied in at build time. Its npm packages are pinned
  | in `package-lock.json`.

  uses = []

  client: responsibility {{ Start `heron lsp` as the language client, and restart it on the command or when `heron.path` changes. }}
  preview: responsibility {{ Show `heron/preview` of the cursor in a webview under a strict content security policy. }}
  commands: responsibility {{ Run `heron check`, `lint` and `generate` as tasks. }}

  property() {

    | The unit tests: the manifest, the language configuration, the grammars, the commands and the preview's policy, with no VS Code.

    verify("editors/vscode/test/unit/extension.test.ts")

  }

  property() {

    | The end-to-end suite: a VS Code that `@vscode/test-electron` downloads opens a copy of the sample tree and checks diagnostics, hover, completion, the preview and a restart against the real `heron lsp`.

    verify("editors/vscode/test/e2e/suite.ts")

  }

  vsix_built: property {
    must {{ build and package `heron.vsix` in the `vscode` lane of CI, which uploads it as the `heron-vsix` artifact and publishes it nowhere }}
    verify("scripts/ci.sh", test = "vscode")
  }
}
