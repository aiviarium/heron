@realizes(heron.product.system.prose_linter)
prose: component("internal/tools/prose", lang = "go") {
  | Two prose providers over the [prose view](#heron.language.markup.prose_view): Vale for style and spelling, and the
  | spec-aware lints of `std/lint`, which [the quality checks](#heron.language.specifications.quality_checks) specify. Both report through
  | `heron lint`, CI and the [language server](#architecture.tools.lsp) alike.

  uses = [architecture.runtime.ast, architecture.runtime.diag, architecture.runtime.lint, architecture.runtime.prose_view, architecture.runtime.registry, architecture.runtime.resolve, architecture.runtime.syntax, architecture.runtime.types]

  vale_provider: responsibility {{ Run Vale over each file's projected regions and map its alerts back onto the source. }}
  spec_provider: responsibility {{ The spec-aware prose lints, coded `Spec.<check>`. }}
  vocabulary: responsibility {{ Accept and reject words in the vocabularies a .vale.ini names. }}
  vale_setup: responsibility {{ Pin Vale in heron.lock and sync its styles from `heron run setup`. }}

  /// The providers, the code actions and the setup step.
  surface(title = "prose") {{
    func Register(r *registry.Registry)
    func SpecProvider() registry.ProseProvider
    func SetupStep() registry.SetupStep
    func ConfigFor(t *resolve.Tree) *ValeConfig
    func Binary() string
    func Actions(d diag.Diagnostic, word string) []Action
    func Commands() []string
    func Run(command string, args []any) error
  }}

  obligation(path = "internal/tools/prose/prose_test.go") {{ Run the real Vale on the sample repository's prose; with `HERON_REQUIRE_VALE` set, a missing Vale fails instead of skipping. }}

  vale_guesses: invariant {
    must {{ mark every fix from Vale as a [suggestion](#heron.tools.prose.vale.suggestion_fix), except a remove and a replace with exactly one replacement }}
    | A spelling fix from `vale fix` is a guess: applied without a reader it split
    | `subtree's` into `sub tree's`.
    verify("internal/tools/prose/prose_test.go", test = "TestValeAlertsMapToWords")
  }

  results_through_lsp: invariant {
    must {{ bring Vale's results to an editor only through [the language server](#architecture.tools.lsp), as diagnostics, fixes and vocabulary actions, with no vale-ls beside it to read raw [Heron files](#heron.language.core_format.files.heron_file) and compete for the same diagnostics }}
    verify("scripts/e2e-lsp.sh")
  }

  verify("scripts/e2e-lsp.sh") {{ [Unit](#delivery.units) 2's [done criterion](#delivery.unit_2) for prose linting: Vale alerts from the team's .vale.ini on the right words of a Heron file in the editor, never inside code or links, with their fixes and vocabulary actions, and unlinked terms flagged in the sample repository. }}
}
