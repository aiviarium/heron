gen: component("internal/core/gen", heron.system.generator, lang = "go") {
  | The generation framework behind `heron generate`: adapters read the checked tree and
  | return files, none with a config format of its own, and the framework writes them and
  | the managed ignore block. Adapters register through the registry's generation
  | targets.

  uses = [architecture.runtime.ast, architecture.runtime.check, architecture.runtime.diag, architecture.runtime.registry, architecture.runtime.resolve, architecture.runtime.syntax, architecture.runtime.types]

  runs_targets: responsibility {{
    Runs the adapters of the targets asked for, or of every target for none, writes each
    file under the project's folder only when its content changed, and reports what it
    wrote.
  }}

  ignore_block: responsibility {{
    Owns the managed block of `.gitignore`, between `# heron:begin` and `# heron:end`, with
    a section per writer under `# from <owner>`: `heron generate` writes `/.heron/` and every
    file an adapter marks as a build output, and `heron run setup` writes its own section
    through `IgnoreSection`. Lines outside the block are kept.
  }}

  ts_target: responsibility {{
    Registers the `ts` target, adapter `gen.ts`: `.heron/types.ts` holds an interface per
    record type and a union per enum, in namespaces by path, after the types `Decimal`,
    `Duration`, `Ref` and `MdastRoot` the built-in types map to, so it imports nothing.
  }}

  exports(title = "gen.go") {{
    // Register installs `heron generate` and the ts target.
    func Register(r *registry.Registry)

    // Input is what an adapter receives, as the `in` of registry.Generator.
    type Input struct {
      Tree    *resolve.Tree
      Checker *types.Checker
      Dir     string // the folder files are written under
    }

    type Result struct {
      Written   []string // paths changed, relative to Dir
      Unchanged []string
    }
    // Run runs the targets' adapters, every target for none, and updates the
    // managed ignore block when it ran every target.
    func Run(ctx context.Context, r *registry.Registry, in *Input, targets []string) (*Result, error)

    func TS(in *Input) ([]registry.GeneratedFile, error)
  }}

  exports(title = "ignore.go") {{
    const (
      BlockBegin    = "# heron:begin (managed by heron; edits inside are replaced)"
      BlockEnd      = "# heron:end"
      OwnerGenerate = "heron generate"
      OwnerSetup    = "heron run setup"
    )
    type IgnoreSection struct{ Owner string }
    func (s IgnoreSection) WriteIgnore(root string, entries []string) (bool, error)
    func IgnoreBlock(text, owner string, entries []string) (string, error)
  }}

  paths_inside: property {
    must_not {{ write a file whose path is absolute, is `.` or leaves the project's folder through `..` }}
    verify("internal/core/gen/gen_test.go", test = "TestPathsStayInside")
  }

  writes_changes_only: property {
    must {{ leave a file whose content is unchanged untouched, so running a target twice changes nothing }}
    verify("internal/core/gen/gen_test.go", test = "TestRunWritesTargetsAndTheBlock")
  }

  sections_kept: property {
    must_not {{ erase another owner's section of the managed block, or any line outside it }}
    verify("internal/core/gen/gen_test.go", test = "TestIgnoreBlockKeepsTheRest")
  }

  responsibility {{ Returns the error no adapter: `no adapter is registered for target "‹target›"; targets: …`, for a target nothing registered. }}
  responsibility {{ Returns the error outside: `generated path "‹path›" is outside the project directory`, from an adapter that returned such a path. }}
  responsibility {{ Returns the error adapter failed: `‹adapter› (‹target›): …`, wrapping the error an adapter returned; files written before it stay written. }}

  property() {

    | Targets run and write once, the ignore block keeps the rest of the file, paths stay inside, and the TS types and bindings of a sample tree.

    verify("internal/core/gen/gen_test.go")

  }
}
