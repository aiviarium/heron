@display("AST")
ast: component("internal/core/ast", heron.system.parser, lang = "go") {
  | Typed views over the syntax tree, one per node kind, generated from the grammar
  | description so the kinds and the parser can't drift apart. Every later stage reads
  | the tree through these views rather than by walking raw children.

  uses = [architecture.runtime.syntax]

  views: responsibility {{
    Gives each node kind of `grammar/heron.ungram` a view type wrapping a `*syntax.Node`,
    with an accessor per child the grammar names, and each alternative of the grammar an
    interface with an `As…` constructor.
  }}

  generator: responsibility {{
    Owns the generator `internal/astgen`, which writes `syntax/kinds_gen.go` and
    `ast/nodes_gen.go` from the grammar.
  }}

  /// Each view is a value; an absent child gives the zero view, whose `N` is
  /// nil, or a nil token.
  exports(title = "nodes_gen.go") {{
    type Declare struct{ N *syntax.Node }
    func (n Declare) Path() Path
    func (n Declare) Params() Params
    func (n Declare) Type() Type
    func (n Declare) Body() Body
    func (n Declare) Annotations() []Annotation

    // Expr is one of: Literal, StringLit, PathExpr, CallExpr, FieldExpr,
    // ArrayExpr, MapExpr, ParenExpr, CastExpr, BinaryExpr, UnaryExpr, IfExpr,
    // ForExpr, ProseLines, ProseBlock, ErrorNode.
    //sumtype:decl
    type Expr interface {
      Node
      // and an unexported marker method
    }
    func AsExpr(n *syntax.Node) Expr
    func IsExprKind(k syntax.Kind) bool
  }}

  exports(lang = "sh", title = "Regenerating") {{
    go run ./internal/core/ast/internal/astgen -grammar grammar/heron.ungram \
      -syntax internal/core/syntax/kinds_gen.go -ast internal/core/ast/nodes_gen.go
  }}

  kinds_generated: property {
    must {{ equal what the generator writes from `grammar/heron.ungram`, so adding a node kind is one edit to the grammar followed by regeneration }}
    verify("scripts/ci.sh", test = "generated code is current")
  }

  switches_exhaustive: property {
    must {{ mark every alternative interface `//sumtype:decl`, so a type switch over one that misses a case fails `go-check-sumtype` in CI }}
    verify("scripts/ci.sh", test = "go-check-sumtype")
  }

  property() {

    | Each view's accessors return the children the grammar names, and the zero view where one is absent.

    verify("internal/core/ast/ast_test.go")

  }
}
