@realizes(heron.product.system.checker, heron.product.system.docs_generator)
lens: component("internal/core/lens", lang = "go") {
  | std/docs's Go side: the lenses a docs site builds, how each one treats a node by its kind
  | and the lens marks on and above it, and the checks on lenses, marks and authored pages.
  | The checker and the docs generator read the same model, so what a lens shows can't
  | drift between them.

  uses = [architecture.runtime.ast, architecture.runtime.diag, architecture.runtime.project, architecture.runtime.resolve, architecture.runtime.syntax, architecture.runtime.types]

  lens_model: responsibility {{
    Reads a tree's docs block into the lenses it builds, in the order it lists them, with
    the default one at the root, or `explore` alone when it lists none; and decides each
    node in a lens as rendered in full, summed up in one line or left out.
  }}

  lens_checks: responsibility {{
    Reports a lens mark or a `lenses` entry naming no lens, a lens list naming what isn't a
    kind or a category, an entry that isn't an authored page, a bad or taken prefix, a site
    without exactly one default lens, and an authored page's example that doesn't check.
  }}

  surface(title = "lens.go") {{
    func SiteOf(t *resolve.Tree, c *types.Checker) *Site
    func (l *Lens) Mode(c *types.Checker, n *resolve.Node) Mode
    func (l *Lens) Marked(c *types.Checker, n *resolve.Node) bool
    func Restriction(c *types.Checker, n *resolve.Node) []*resolve.Node
    func ProseRestriction(c *types.Checker, site resolve.Site) []*resolve.Node
    func Check(t *resolve.Tree, c *types.Checker, examples ExampleChecker) (diag.List, map[string]bool)
  }}
}
