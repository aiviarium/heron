syntax: component("internal/core/syntax", heron.system.parser, lang = "go") {
  | Splits one [Heron file](#heron.language.core_format.files.heron_file) into tokens and parses it into a [lossless tree](#heron.language.grammar.recovery.lossless_tree):
  | every byte of the input belongs to exactly one token, so printing the tokens in order
  | gives the input back, errors included. It's the first stage, and every later one reads
  | its tree.

  uses = []

  parses: responsibility {{
    Reads a file's text into nodes and tokens, switching modes for `|` lines, `{{ }}`
    bodies, `do` code, strings and [prose files](#heron.language.core_format.prose_layer.prose_file), the last chosen by a name ending
    in `.heron.md`.
  }}

  recovers: responsibility {{
    Recovers from every syntax error with an error node and a diagnostic, and goes on, so
    a half-written file still has a tree for the language server.
  }}

  kinds: responsibility {{
    Holds the node and token kinds, generated into `kinds_gen.go` from `grammar/heron.ungram`
    by `ast`'s generator.
  }}

  exports(title = "tree.go") {{
    type Tree struct {
      Name  string
      Src   string
      Root  *Node
      Diags []Diagnostic
    }

    // Parse parses a Heron file. A name ending in ".heron.md" is a prose file.
    func Parse(name, src string) *Tree

    type Node struct {
      Kind     Kind
      Children []Elem
      Parent   *Node
    }
    func (n *Node) Span() (int, int)
    func (n *Node) Text() string
    func (n *Node) Tokens(f func(*Token))
    func (n *Node) Walk(f func(*Node) bool)

    type Token struct {
      Kind  Kind
      Text  string
      Start int
    }

    // Diagnostic is a syntax error with the byte range it concerns.
    type Diagnostic struct {
      Start, End int
      Message    string
    }

    func LineCol(src string, off int) (line, col int)
    func Dump(n *Node) string
  }}

  @display("No I/O")
  no_io: property {
    must_not {{ import `os`, `os/exec`, `net`, `net/http`, `io/fs`, `io/ioutil`, `syscall` or `path/filepath` }}
    verify("scripts/ci.sh", test = "syntax and eval do no I/O")
  }

  lossless: property {
    must {{ return a tree whose tokens, printed in order, equal the input, for every input, a prefix of any fixture and fuzzed text included }}
    verify("internal/core/syntax/lossless_test.go", test = "FuzzParse")
  }

  @display("One pass")
  one_pass: property {
    must {{ read the input once, left to right, with a scanner the parser drives in the mode it's in, and no separate token pass }}
  }

  never_panics: property {
    must_not {{ panic or loop on any input; nesting deeper than 256 levels is a [too deep](#heron.language.grammar.recovery.errors.too_deep) error }}
    verify("internal/core/syntax/grammar_test.go", test = "TestRecoveryDepth")
  }

  responsibility {{ Returns the error syntax: Every syntax error, as a `Diagnostic` in `Tree.Diags` with the byte range it concerns;
    `check` reports them under the code `syntax`. The messages are the
    [recovery diagnostics](#heron.language.grammar.recovery.errors). }}

  property() {

    | Lexical tokens, structure, code, strings, prose and recovery parse to the expected trees.

    verify("internal/core/syntax/grammar_test.go")

  }
  property() {
    | Every prefix of every fixture parses without losing a byte, and fuzzing finds no input that does.
    verify("internal/core/syntax/lossless_test.go")
  }
  property() {
    | Every Heron fixture parses without an error, unless it's marked as showing one.
    verify("internal/core/syntax/fixtures_test.go")
  }
  property() {
    | Each member parses to the shape its syntax gives it.
    verify("internal/core/syntax/shape_test.go")
  }
}
