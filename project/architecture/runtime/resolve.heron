@realizes(heron.system.checker)
resolve: component("internal/core/resolve", lang = "go") {
  | Follows an [entry point](#heron.language.core_format.files.entry_point) into one node tree: `import` [mounts](#heron.language.core_format.mounts.mount) packages,
  | `include` places a tree's own files, bindings amend by path, and names resolve through
  | scopes. Its output is the tree every later stage reads. It's the stage that implements
  | most of the [core format](#heron.language.core_format).

  uses = [architecture.runtime.ast, architecture.runtime.diag, architecture.runtime.syntax, architecture.runtime.std]

  loads: responsibility {{
    Reads and parses files through a `Loader`, which memoizes each parse by content hash
    and lets an overlay of unsaved text win over the disk, for the language server.
  }}

  identifies: responsibility {{
    Gives each file one identity, `FileID`: its cleaned absolute path with symlinks
    resolved, or `std:` and its path for an embedded standard file.
  }}

  builds_tree: responsibility {{
    Declares, enters, sets and amends nodes in reading order, [mounts](#heron.language.core_format.mounts.mount) imported packages,
    places included files and folders, and records every site that touched a node, so
    `types`, the lints and the language server can point at each.
  }}

  finds_packages: responsibility {{
    Finds a standard package in `std/` embedded in the binary, and any other package
    `owner/name@major` as `owner/name/package.heron` under the package directories
    the resolver is given, memoizing each package once per resolver.
  }}

  builtins: responsibility {{
    Holds the primitive types every tree sees without an import, as the outermost scope,
    and the prelude `std/core`.
  }}

  exports(title = "tree.go") {{
    type FileID string
    func Canonical(p string) (FileID, error)

    type Loader struct {
      // Overlay holds unsaved contents by identity; it wins over the disk.
      Overlay map[FileID]string
      Parses  int // files parsed, for tests of memoization
    }
    func NewLoader() *Loader
    func (l *Loader) Load(id FileID) (*File, error)

    type Resolver struct {
      Loader      *Loader
      PackageDirs []string // "acme/widgets@1" is DIR/acme/widgets/package.heron
      Context     *Scope   // the outermost scope of the trees Resolve reads
    }
    func New(l *Loader) *Resolver
    func (r *Resolver) Resolve(entry FileID) *Tree
    func (r *Resolver) Package(spec string) (*Package, diag.List)

    type Tree struct {
      Entry   *File
      Root    *Node
      Files   []*File    // the tree's own files, in the order they joined it
      Imports []*Package // every package imported anywhere in the tree
      Diags   diag.List
    }
    func (t *Tree) Find(path string) *Node
    func (t *Tree) Walk(f func(*Node))
    func (t *Tree) PackageDiags() diag.List

    type Node struct {
      Name        string
      Parent      *Node
      Shape       Shape
      Children    []*Node
      Decl        Site   // the member that declared or created the node
      Sites       []Site // every other member that entered or amended it
      Value       ast.Expr
      Prose, Code []Site
      Annotations []Site
      Docs        []Site
      Origin      *Node // the package node a mounted node stands for
    }
    func (n *Node) Path() string
    func (n *Node) Child(name string) *Node
  }}

  one_identity: property {
    must {{ give a file reached by several spellings, through `..`, a symlink or a relative path, one `FileID`, so the include guard, the parse memo and the language server agree on it }}
    verify("internal/core/resolve/resolve_test.go", test = "TestCanonicalIdentity")
  }

  parse_memo: property {
    must {{ parse a file again only when its content hash changed since the loader last parsed it }}
    verify("internal/core/check/memo_test.go", test = "TestIncrementalRecomputation")
  }

  finite_on_cycles: property {
    must {{ terminate on an include cycle, placing each file once, and report an import cycle as an error }}
    verify("internal/core/resolve/resolve_test.go", test = "TestIncludeCycleIsFinite")
    verify("internal/core/resolve/resolve_test.go", test = "TestImportCycleIsAnError")
  }

  responsibility {{ Returns the error import: An import that names no package, a bad or missing major version, or a package that isn't installed: the [import diagnostics](#heron.language.core_format.imports). }}
  responsibility {{ Returns the error import-cycle: Two packages that import each other. }}
  responsibility {{ Returns the error include: An include that names no file or folder. }}
  responsibility {{ Returns the error directive: An `import` or `include` that isn't a list of plain strings. }}
  responsibility {{ Returns the error conflict: A node declared, exported or set twice: the [conflict diagnostics](#heron.language.core_format.conflicts). }}
  responsibility {{ Returns the error read: An [entry point](#heron.language.core_format.files.entry_point) that can't be read. }}
  responsibility {{ Returns the error syntax: The syntax errors of every file read, forwarded from `syntax`. }}

  property() {

    | File identity, include guards and [mounts](#heron.language.core_format.mounts.mount), cycles, declare and enter conflicts, amend order, scoped imports, exports, prose-file headings, local visibility, the standard packages, and the import and include diagnostics.

    verify("internal/core/resolve/resolve_test.go")

  }
}
