@display("Standard packages")
std: component("std", heron.system.checker, heron.language.std, lang = "go") {
  | Embeds the standard packages, which are Heron source, into the binary. They're read and
  | checked like any other package; the embedded copy is the fallback a newer copy from a
  | registry would replace. Their surface is specified with the language, under
  | [the standard packages](#heron.language.std).

  uses = []

  embeds: responsibility {{
    Holds every standard package as `<name>/package.heron` and the files it includes, such
    as `doc/package.heron` for `std/doc`, in one embedded file system that `resolve` reads
    as `std:` files.
  }}

  exports(title = "std.go") {{
    //go:embed */*.heron
    var FS embed.FS
  }}

  heron_source: property {
    must {{ write each standard package, such as `std/types` and `std/doc`, as Heron source, and back with Go only what Heron can't say, such as process control }}
    | For example, `std/process`'s `run` is declared in Heron and implemented by `eval`'s natives; `std/repo`'s funcs by `setup`.
  }

  std_checks_clean: property {
    must {{ check and lint every standard package clean, as a package }}
    verify("internal/core/types/types_test.go", test = "TestStdPackagesCheckClean")
    verify("internal/core/lint/lint_test.go", test = "TestStdLintsClean")
  }
}
