eval: component("internal/core/eval", heron.system.interpreter, lang = "go") {
  | The interpreter for the `do` code of funcs, macros, tasks and [hooks](#heron.language.scripting.code.hook). It does no I/O of
  | its own: processes, files, the environment and the clock come in through capabilities,
  | and built-in funcs and transports through the registry, so a run is replayable from what
  | those returned.

  uses = [architecture.runtime.ast, architecture.runtime.registry, architecture.runtime.resolve, architecture.runtime.syntax, architecture.runtime.types]

  interprets: responsibility {{
    Runs statements and expressions over a checked tree: lets, assignment to node fields,
    `if`, `for`, calls with positional and named arguments, trailing blocks as steps,
    `attempt(…)`, embedded languages, and the built-in members and methods of values.
  }}

  calls: responsibility {{
    Calls a Heron func or task, a macro's expansion, a func the registry implements, and
    an op through the transport its binding names.
  }}

  natives: responsibility {{
    Backs the standard funcs that can't be written in Heron: `core.log`, `core.emit`,
    `process.run`, `files.read`, `files.write`, `files.temp`, `json.decode` and
    `json.encode`.
  }}

  events: responsibility {{
    Reports each call, step, log line, field set and process to `OnEvent`,
    in order, for the run record.
  }}

  exports(title = "eval.go") {{
    type Machine struct {
      Tree     *resolve.Tree
      Types    *types.Checker
      Registry *registry.Registry
      Caps     Caps
      Dir      string      // where relative paths in run, read and write start
      OnEvent  func(Event) // what the run did, in order
      State    map[*resolve.Node]map[string]Value // fields code set on nodes
    }
    func New(t *resolve.Tree, c *types.Checker, r *registry.Registry, caps Caps) *Machine
    func (m *Machine) Call(ctx context.Context, fn *resolve.Node, args Args) (Value, error)
    func (m *Machine) RunCode(ctx context.Context, n *resolve.Node, vars map[string]Value) (Value, error)
    func (m *Machine) Expand(ctx context.Context, macro *resolve.Node, args Args) (string, error)
    func (m *Machine) Close() error // removes what the run made, such as temp(…) files
    func MachineOf(ctx context.Context) *Machine

    type Args struct {
      Positional []Value
      Named      map[string]Value
    }

    // Error is a fault in code; it fails the run and attempt(…) doesn't catch it.
    type Error struct {
      File      string
      Line, Col int
      Msg       string
    }
    // Throw is an error thrown as a Heron value; attempt(…) catches it.
    type Throw struct{ Value *Record }
    func Thrown(typ string, fields map[string]Value) *Throw
  }}

  exports(title = "caps.go") {{
    // A nil capability fails the call that needs it.
    type Caps struct {
      Processes Processes
      Files     Files
      Env       Env
      Clock     Clock
      Log       func(line string)
    }
    type Processes interface {
      Run(ctx context.Context, c Command) (Exit, error)
    }
    // A command is always an argument list, never a line for a shell to split.
    type Command struct {
      Path  string
      Args  []string
      Env   []string
      Dir   string
      Stdin []byte
    }
    type Exit struct {
      Code           int
      Stdout, Stderr []byte
    }
    type Files interface {
      Read(path string) ([]byte, error)
      Write(path string, data []byte) error
      TempDir() (string, error)
      RemoveAll(path string) error
    }
    type Env interface{ Environ() []string }
    type Clock interface{ Now() time.Time }
  }}

  exports(title = "value.go") {{
    // Value is nil, bool, int64, float64, string, []Value, map[string]Value,
    // *Record, Text, Ref or TypeValue. Enum variants are their names.
    type Value = any
    type Record struct {
      Type   string
      Fields map[string]Value
    }
    func Plain(v Value) any     // the form registered funcs and transports take
    func FromPlain(v any) Value
    func Str(v Value) string
    func Equal(a, b Value) bool
  }}

  @display("No I/O")
  no_io: property {
    must_not {{ import `os`, `os/exec`, `net`, `net/http`, `io/fs`, `io/ioutil`, `syscall` or `path/filepath` }}
    verify("scripts/ci.sh", test = "syntax and eval do no I/O")
  }

  argument_lists: property {
    must {{ start every process from an argument list, the program and its arguments, never a line for a shell to split }}
    verify("internal/core/eval/host/host_test.go", test = "TestRunPassesArgumentsWithoutAShell")
  }

  faults_not_caught: property {
    must_not {{ let `attempt(…)` catch a fault in code, such as an unknown name or a wrong operand; it catches only [thrown errors](#heron.language.scripting.code.thrown_error) }}
    verify("internal/core/eval/eval_test.go", test = "TestCodeErrors")
  }

  responsibility {{ Returns the error *eval.Error: A fault in code, with the file, line and column: an unknown name, a wrong operand, division by zero, a non-Bool condition. It fails the run. }}
  responsibility {{ Returns the error *eval.Throw: An error thrown as a Heron value, such as a `ProcessError` from a process that exits non-zero; uncaught, it fails the run. }}

  property() {

    | Bindings and control flow, operators, processes and files through fake capabilities, throws and faults, tasks, macros, node fields and [hooks](#heron.language.scripting.code.hook), registered funcs, steps, strings and JSON.

    verify("internal/core/eval/eval_test.go")

  }
  property() {
    | Ops through their bound transport.
    verify("internal/core/eval/transport_test.go")
  }

  verify("scripts/e2e-tasks.sh") {{ [Unit](#delivery.units) 1's [done criterion](#delivery.unit_1) for tasks: `heron run` runs a task with params from the command line, asks for missing ones, honours `@needs` and `@undo`, and records the run. }}
}

eval_host: component("internal/core/eval/host", heron.system.interpreter, lang = "go") {
  | Supplies `eval`'s capabilities from the operating system: processes through `os/exec`,
  | files through `os`, the process environment and the wall clock. `heron run` and the
  | language server's task runs use it; tests use fakes instead.

  uses = [architecture.runtime.eval]

  exports(title = "host.go") {{
    // Caps returns the real capabilities, with log lines going to log.
    func Caps(log func(string)) eval.Caps

    type Processes struct{} // os/exec with the argument list; a non-zero exit is no error here
    type Files struct{}     // Write makes the file's folder; TempDir makes heron-run-*
    type Env struct{}       // os.Environ
    type Clock struct{}     // time.Now
  }}

  no_shell: property {
    must_not {{ start a process through a shell }}
    verify("internal/core/eval/host/host_test.go", test = "TestRunPassesArgumentsWithoutAShell")
  }

  property() {

    | Arguments reach the process as given, quotes and spaces included, and files are read and written.

    verify("internal/core/eval/host/host_test.go")

  }
}
