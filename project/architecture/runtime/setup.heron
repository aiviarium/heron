setup: component("internal/core/setup", heron.system.interpreter, heron.system.command_line, lang = "go") {
  | Backs `std/repo`: the toolchain check, the packages and sources pinned in `heron.lock`,
  | and the generated files `heron run setup` writes, and `std/spec`'s `git(…)`. Its funcs
  | run inside `eval` and reach the tree, the project's root and processes through the
  | machine that calls them, so a fake process capability tests them and every process
  | they start is in the run record.

  uses = [architecture.runtime.check, architecture.runtime.eval, architecture.runtime.gen, architecture.runtime.registry, architecture.runtime.resolve, architecture.runtime.types]

  toolchain: responsibility {{
    Implements `repo.ensure_toolchain(tools, install = false)`: runs `<tool> --version` for
    each tool, matches its leading numbers against the version asked for, and with
    `install` installs pnpm and yarn through npm, leaving node to the machine's version
    manager.
  }}

  packages: responsibility {{
    Implements `repo.install_packages(update = false)`: pins every versioned package the
    tree imports at its declared version and a SHA-256 over its files, pins each project's
    [git source](#heron.language.specifications.projects.git_source) by the commit its ref names and checks it out at the project's path, runs
    every registered setup step, and writes `heron.lock` sorted and formatted. A package's
    checksum is a SHA-256 over its files, by path inside the package and content; a source
    is pinned again when its url or ref changes.
  }}

  generates: responsibility {{
    Implements `repo.generate()`: runs every generation target, as `heron generate` without
    targets does, then writes setup's section of the managed ignore block, `/.heron/` and
    each source's checkout, and returns the paths it wrote.
  }}

  exports(title = "setup.go") {{
    // Register installs the Go side of std/repo's funcs and of std/spec's git(…).
    func Register(r *registry.Registry, o Options)

    type Options struct {
      Ignore     IgnoreWriter         // nil uses gen's section for setup
      Installers map[string]Installer // nil uses DefaultInstallers
    }
    type IgnoreWriter interface {
      WriteIgnore(root string, entries []string) (changed bool, err error)
    }
    type Installer func(version string) (eval.Command, bool)
    func DefaultInstallers() map[string]Installer // pnpm and yarn through npm
  }}

  exports(title = "lock.go") {{
    type Lock struct {
      Packages map[string]Pin
      Sources  map[string]SourcePin
      Tools    map[string]registry.ToolPin
    }
    type Pin struct{ Version, Checksum string }
    type SourcePin struct{ URL, Ref, Commit string }
    func ReadLock(file string) (*Lock, error)
    func (l *Lock) Format() string
  }}

  idempotent: property {
    must {{ change no file outside `.heron/` when run a second time on an unchanged repository }}
    verify("scripts/e2e-setup.sh")
  }

  pins_hold: property {
    must_not {{ move a pin of `heron.lock` that no longer matches what it pins, unless asked with `update`; it fails naming the pin instead }}
    verify("scripts/e2e-setup.sh")
  }

  generate_runs_targets: property {
    | Applies when `repo.generate()` runs.
    must {{ run every registered generation target and write its files before writing setup's section of the ignore block }}
    | Then the `.heron/` types TS code imports exist after a fresh `heron run setup`.
    verify("internal/core/setup/setup_test.go", test = "TestGenerateRunsEveryTarget")
    verify("scripts/e2e-setup.sh")
  }

  responsibility {{ Returns the error SetupError: A thrown `SetupError` that `attempt(…)` can catch: a tool missing or at the wrong version, a pin that moved, a source that can't be pinned or checked out, a setup step or a generation target that failed. }}

  property() {

    | The toolchain check and install, the ignore block, the lock's round trip, and `generate()` running every target.

    verify("internal/core/setup/setup_test.go")

  }
  property() {
    | A fresh copy of `examples/petstore` sets up, pins its source and packages, writes the block, generates `.heron/types.ts`, and a second run changes nothing.
    verify("scripts/e2e-setup.sh")
  }

  verify("scripts/e2e-setup.sh") {{ [Unit](#delivery.units) 1's [done criterion](#delivery.unit_1) for setup: `heron run setup` on a fresh checkout checks the toolchain, pins and installs what `heron.lock` lists, runs the generation targets, writes the managed ignore block, and changes nothing when it runs again. }}
}
