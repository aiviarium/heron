@realizes(heron.product.system.interpreter)
records: component("internal/core/records", lang = "go") {
  | Stores audit records, release output and caches as data files. Record kinds register
  | through the registry, so every [unit](#delivery.units)'s records are written and read through one
  | store, the language server's gutter included.

  uses = [architecture.runtime.eval, architecture.runtime.registry]

  stores: responsibility {{
    Writes, lists, reads and prunes the records of every registered kind, each one JSON
    file, `<location>/<kind>/<id>.json`, holding its kind, the kind's version, its id, its
    time in UTC and its data.
  }}

  run_kind: responsibility {{
    Registers the `run` kind and records a `heron run` from the interpreter's events: its
    task, entry, arguments, the tasks it ran in order with their role (`needed`, `task` or
    `undo`), status and timing, its steps, processes, logs, calls and resources, and its
    result or error and exit status.
  }}

  surface(title = "records.go") {{
    const DefaultPath = ".heron/audit"

    type Config struct {
      Path  string            // every kind's location; relative paths start at the root
      Paths map[string]string // a location for single kinds, by kind name
      Keep  time.Duration     // how long Prune keeps records; zero keeps them all
    }
    func Open(root string, cfg Config, r *registry.Registry) *Store

    type Record struct {
      Kind    string         `json:"kind"`
      Version int            `json:"version"`
      ID      string         `json:"id"`
      Time    time.Time      `json:"time"`
      Data    map[string]any `json:"data"`
    }
    func (s *Store) Write(kind string, data map[string]any) (*Record, error)
    func (s *Store) List(kind string) ([]*Record, error) // newest first
    func (s *Store) Read(kind, id string) (*Record, error)
    func (s *Store) Prune() (int, error)
    func (s *Store) Dir(kind string) string
  }}

  surface(title = "run.go") {{
    const RunKind = "run"
    func Register(r *registry.Registry)
    func NewRunRecorder(task, entry string, args map[string]eval.Value, now func() time.Time) *RunRecorder
    func (r *RunRecorder) ID() string
    func (r *RunRecorder) OnEvent(e eval.Event)
    func (r *RunRecorder) OnResource(e registry.ResourceEvent)
    func (r *RunRecorder) StartTask(path, role string)
    func (r *RunRecorder) FinishTask(result eval.Value, err error)
    func (r *RunRecorder) Data(result eval.Value, err error, exit int) map[string]any
  }}

  ids_sort_by_time: invariant {
    must {{ give each record an id that starts with its UTC time to the millisecond, as `20261125T093000.123Z`, followed by six random hexadecimal digits, so a folder listing in name order is the history }}
  }

  whole_files: invariant {
    must {{ write a record to a temporary file and rename it into place, so a reader never sees half a record }}
  }

  default_location: invariant {
    | Applies when no [unit](#delivery.units) configures where records go.
    must {{ keep them under `.heron/audit/` at the project's root, which `heron run` takes to be the folder of its [entry point](#heron.language.core_format.files.entry_point) }}
    verify("internal/core/cli/run_test.go", test = "TestRunIsRecorded")
  }

  location_registered: invariant {
    | Planned: not built yet.
    | Where a [unit](#delivery.units) owns the configuration of where records go, as the DevOps [unit](#delivery.units) does with `audit { path, keep }`.
    must {{ let that [unit](#delivery.units) register the location and how long records are kept through the registry, read by every command that opens the store }}
  }

  raises("unknown kind") {{ `records: no record kind "‹kind›" is registered`, for a write or read of a kind nothing registered. }}
  raises("invalid record") {{ `records: a ‹kind› record is invalid: …`, when the kind's validation rejects the data; nothing is written. }}
  raises("bad id") {{ `records: bad id "‹id›"`, for an id with a slash in it. }}

  obligation(path = "internal/core/records/records_test.go") {{ A sample kind registered from outside writes, lists, reads, validates and prunes; the run recorder turns events into a run record. }}
}
