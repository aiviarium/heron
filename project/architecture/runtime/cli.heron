@display("CLI")
@realizes(heron.system.command_line)
cli: component("internal/core/cli", lang = "go") {
  | Dispatches the binary's subcommands and registers [unit](#delivery.units) 1's commands, core lints,
  | record kinds and setup funcs. Each command's arguments, options and exit codes are in
  | [the command reference](#heron.cli); this component holds what they share.

  uses = [architecture.runtime.ast, architecture.runtime.check, architecture.runtime.diag, architecture.runtime.eval, architecture.runtime.eval_host, architecture.runtime.format, architecture.runtime.lint, architecture.runtime.records, architecture.runtime.registry, architecture.runtime.resolve, architecture.runtime.setup, architecture.runtime.types, architecture.runtime.version]

  dispatches: responsibility {{
    Looks the first argument up among the registered commands and runs it with the rest;
    prints the usage to standard error for no argument or an unknown command, and a
    command's usage line and summary for `heron help <command>`.
  }}

  registers_unit_one: responsibility {{
    Registers `check`, `fmt`, `lint`, `run` and `version`, the core lints, the `run` record kind and
    `std/repo`'s funcs. `generate` is registered by `gen`, and the commands of later
    [units](#delivery.units) by those [units](#delivery.units).
  }}

  entry_points: responsibility {{
    Turns each argument of `check` and `lint` into an [entry point](#heron.language.core_format.files.entry_point): a file, or a folder's
    `index.heron`, relative to the working folder, with `.` when none is given.
  }}

  exports(title = "cli.go") {{
    // Register installs unit 1's commands and core lints.
    func Register(r *registry.Registry)
    // Main runs the subcommand named by args[0] and returns the exit code.
    func Main(r *registry.Registry, args []string, env *registry.Env) int
    // OSEnv is the environment of the running process.
    func OSEnv() *registry.Env
  }}

  relative_paths: property {
    must {{ print the path of every diagnostic relative to the working folder, in text and in JSON }}
    verify("internal/core/cli/check_test.go", test = "TestCheckCommand")
  }

  help_exit: property {
    | Applies when `heron` runs with no arguments, or with `help`, `-h` or `--help`.
    must {{ list every registered command with its summary, sorted by name, on standard error }}
    | Then the exit status is 2 with no arguments and 0 otherwise.
    verify("internal/core/cli/cli_test.go", test = "TestSampleCommand")
  }

  unknown_command: property {
    | Applies when the first argument names no registered command.
    must {{ print `heron: unknown command "‹name›"` and the usage on standard error, and exit with status 2 }}
    verify("internal/core/cli/cli_test.go", test = "TestSampleCommand")
  }

  property() {

    | A command registered from outside dispatches and shows in help; `fmt` rewrites and checks.

    verify("internal/core/cli/cli_test.go")

  }
  property() {
    | `check` in text and JSON, and a lint registered from outside through `lint`.
    verify("internal/core/cli/check_test.go")
  }
  property() {
    | `run` parameters, needs, undo, confirmation, records and repository tasks.
    verify("internal/core/cli/run_test.go")
  }
  property() {
    | `check --watch` rechecks only the edited node.
    verify("internal/core/cli/watch_test.go")
  }
  property() {
    | `lint -fix` never applies a suggestion.
    verify("internal/core/cli/fix_test.go")
  }

  verify("internal/core/cli/check_test.go", test = "TestCheckCommand") {{ [heron check](#heron.cli.check) as the spec gives it. }}
  verify("scripts/ci.sh", test = "spec/ and examples/ check and lint clean; spec examples are the fixtures") {{ [heron check](#heron.cli.check) end to end. }}
  verify("internal/core/cli/cli_test.go", test = "TestFmt") {{ [heron fmt](#heron.cli.fmt) as the spec gives it. }}
  verify("scripts/ci.sh", test = "fixtures") {{ [heron fmt](#heron.cli.fmt) over the fixtures. }}
  verify("internal/core/cli/check_test.go", test = "TestSampleLint") {{ [heron lint](#heron.cli.lint) on the sample repository. }}
  verify("scripts/e2e-prose.sh") {{ [heron lint](#heron.cli.lint) with a prose provider. }}
  verify("internal/core/cli/run_test.go", test = "TestRunParamsAndNeeds") {{ [heron run](#heron.cli.run) with params and needs. }}
  verify("scripts/e2e-tasks.sh") {{ [heron run](#heron.cli.run) end to end. }}
  verify("internal/core/gen/gen_test.go", test = "TestRunWritesTargetsAndTheBlock") {{ [heron generate](#heron.cli.generate) writes the targets and the ignore block. }}
  verify("scripts/e2e-interop.sh") {{ [heron generate](#heron.cli.generate) with an extension's target. }}
  verify("scripts/e2e-docs.sh") {{ [heron generate](#heron.cli.generate) `docs`. }}
  verify("internal/core/cli/cli_test.go", test = "TestSampleCommand") {{ [heron help](#heron.cli.help) and a sample command. }}
  verify("internal/core/cli/cli_test.go", test = "TestVersionCommand") {{ [heron version](#heron.cli.version) and `heron --version`. }}
}
