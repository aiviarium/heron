  }

  proves(heron.language.markup.prose_view.regions) {
    verify("internal/core/lint/prose_test.go", test = "TestProseProvider")
  }

  proves(heron.language.markup.prose_view.masked_spans) {
    verify("internal/core/lint/prose_test.go", test = "TestProseProvider")
  }

  proves(heron.language.markup.prose_view.projected_text) {
    verify("internal/core/lint/prose_test.go", test = "TestProseProvider")
  }

  proves(heron.language.markup.prose_view.exact_map) {
    verify("internal/core/lint/prose_test.go", test = "TestProseFixtureSourceMaps")
  }

  proves(heron.language.markup.prose_view.fixes_exact) {
    verify("internal/core/lint/prose_test.go", test = "TestProseProvider")
  }

  proves(heron.language.markup.prose_view.regions_cached) {
    verify("internal/core/lint/prose_test.go", test = "TestProseCache")
  }

  proves(heron.language.markup.prose_view.html_projection) {
    verify("internal/core/lint/prose_test.go", test = "TestProseHTML")
  }

  proves(heron.language.markup.prose_view.providers_in_pipeline) {
    verify("internal/core/lint/prose_test.go", test = "TestProseAllow")
  }
}
