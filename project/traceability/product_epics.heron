product_epics: section {
  | The tests that prove the acceptance criteria of the spec's [epics](#heron.product.epics).

  proves(heron.product.epics.documenting.user_audience.tasks_first.opens_on_tasks) {
    verify("internal/tools/docs/lenses_test.go", test = "TestUserLens")
  }

  proves(heron.product.epics.documenting.user_audience.tasks_first.no_rules_shown) {
    verify("internal/tools/docs/lenses_test.go", test = "TestUserLens")
  }

  proves(heron.product.epics.documenting.user_audience.tasks_first.errors_as_fixes) {
    verify("internal/tools/docs/lenses_test.go", test = "TestUserLens")
  }

  proves(heron.product.epics.documenting.user_audience.pages_stay_true.broken_example_fails) {
    verify("internal/core/lens/lens_test.go", test = "TestAuthoredExamplesCheck")
  }

  proves(heron.product.epics.documenting.user_audience.pages_stay_true.fact_follows_spec) {
    verify("internal/tools/docs/lenses_test.go", test = "TestAuthoredPagesRender")
  }

  proves(heron.product.epics.documenting.user_audience.pages_stay_true.fact_gone_fails) {
    verify("internal/core/lens/lens_test.go", test = "TestAuthoredPageChecks")
  }

  proves(heron.product.epics.documenting.developer_audience.write_for_readers.authored_page_shown) {
    verify("internal/tools/docs/lenses_test.go", test = "TestUserLens")
  }

  proves(heron.product.epics.documenting.developer_audience.write_for_readers.marked_for_users) {
    verify("internal/tools/docs/lenses_test.go", test = "TestLensMarksRender")
  }

  proves(heron.product.epics.documenting.developer_audience.write_for_readers.unknown_lens_reported) {
    verify("internal/core/lens/lens_test.go", test = "TestUnknownLens")
  }

  proves(heron.product.epics.documenting.developer_audience.read_by_topic.topics_and_lines) {
    verify("internal/tools/docs/lenses_test.go", test = "TestDeveloperLens")
  }

  proves(heron.product.epics.documenting.developer_audience.read_by_topic.readable_rule) {
    verify("internal/tools/docs/lenses_test.go", test = "TestRuleAsProse")
  }

  proves(heron.product.epics.documenting.developer_audience.own_lenses.declared_lens_built) {
    verify("internal/tools/docs/lenses_test.go", test = "TestOwnLenses")
  }

  proves(heron.product.epics.documenting.developer_audience.own_lenses.override_used) {
    verify("internal/tools/docs/lenses_test.go", test = "TestOwnLenses")
  }

  proves(heron.product.epics.documenting.implementer_audience.full_view.everything_in_explore) {
    verify("internal/tools/docs/lenses_test.go", test = "TestExploreLens")
    verify("internal/tools/docs/lenses_test.go", test = "TestLensMarksRender")
  }

  proves(heron.product.epics.documenting.implementer_audience.same_node_everywhere.switch_keeps_place) {
    verify("internal/tools/docs/lenses_test.go", test = "TestLensSwitcher")
  }

  proves(heron.product.epics.documenting.implementer_audience.same_node_everywhere.hidden_target_opens) {
    verify("internal/tools/docs/lenses_test.go", test = "TestLinksAcrossLenses")
  }
}
