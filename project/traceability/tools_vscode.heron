tools_vscode: section {
  | The tests that prove the requirements of the spec's [VS Code extension](#heron.tools.vscode):
  | the unit tests of `editors/vscode`, which need no VS Code, and its end-to-end suite, which
  | runs in a real VS Code against `heron lsp` on a sample tree.

  proves(heron.tools.vscode.client.starts_the_server) {
    verify("editors/vscode/test/e2e/suite.ts", test = "the extension activates and starts heron lsp")
    verify("editors/vscode/test/e2e/suite.ts", test = "diagnostics come from the language server")
    verify("editors/vscode/test/e2e/suite.ts", test = "hover shows a node's docs")
    verify("editors/vscode/test/e2e/suite.ts", test = "completion offers the tree's nodes in a link")
    verify("editors/vscode/test/unit/extension.test.ts", test = "the server: heron.path, or heron on PATH, started as heron lsp --stdio")
  }

  proves(heron.tools.vscode.client.starts_the_server_otherwise) {
    verify("editors/vscode/test/unit/extension.test.ts", test = "no server: a message that names the command and the heron.path setting")
  }

  proves(heron.tools.vscode.errors.server_not_running) {
    verify("editors/vscode/test/unit/extension.test.ts", test = "no server: a message that names the command and the heron.path setting")
  }

  proves(heron.tools.vscode.client.restart_command) {
    verify("editors/vscode/test/e2e/suite.ts", test = "Restart Language Server starts a new client")
  }

  proves(heron.tools.vscode.languages.languages_contributed) {
    verify("editors/vscode/test/unit/extension.test.ts", test = "languages: heron for .heron and heron-md for .heron.md, each with its grammar")
    verify("editors/vscode/test/unit/extension.test.ts", test = "grammars: the extension's are the published ones, as the generator writes them")
    verify("editors/vscode/test/e2e/suite.ts", test = "a .heron file is heron and a .heron.md file is heron-md")
  }

  proves(heron.tools.vscode.languages.language_configuration) {
    verify("editors/vscode/test/unit/extension.test.ts", test = "language configuration: comments, brackets, auto-closing, folding and words")
  }

  proves(heron.tools.vscode.preview.preview_to_the_side) {
    verify("editors/vscode/test/e2e/suite.ts", test = "the preview shows the node at the cursor and follows edits and the cursor")
  }

  proves(heron.tools.vscode.preview.preview_csp) {
    verify("editors/vscode/test/unit/extension.test.ts", test = "the preview's policy: nothing by default, style and script by nonce, no network")
  }

  proves(heron.tools.vscode.commands.cli_commands) {
    verify("editors/vscode/test/unit/extension.test.ts", test = "commands: check, lint, generate docs, and generate with the targets picked")
  }

  proves(heron.tools.vscode.package.one_bundle) {
    verify("editors/vscode/test/unit/extension.test.ts", test = "bundles: one for the desktop and one for the browser, and no publish step")
    verify("scripts/ci.sh", test = "vscode")
  }

  proves(heron.tools.vscode.package.extension_icon) {
    verify("editors/vscode/test/unit/extension.test.ts", test = "icon: Heron's icon, a 128 px PNG the manifest names and the package keeps")
  }

  proves(heron.tools.vscode.fixing.fix_a_diagnostic) {
    verify("editors/vscode/test/e2e/suite.ts", test = "diagnostics come from the language server")
    verify("editors/vscode/test/e2e/suite.ts", test = "hover shows a node's docs")
    verify("internal/tools/lsp/lsp_test.go", test = "TestErrorsAppearClearAndReachImporters")
  }

  proves(heron.tools.lsp.extensions.preview_request) {
    verify("internal/tools/lsp/features_test.go", test = "TestPreviewRequest")
    verify("editors/vscode/test/e2e/suite.ts", test = "the preview shows the node at the cursor and follows edits and the cursor")
  }

  proves(heron.tools.lsp.extensions.preview_request_otherwise) {
    verify("internal/tools/lsp/preview_test.go", test = "TestPreviewRenderFails")
  }
}
