language_std: section {
  | The tests that prove the requirements of the spec's [language.std](#heron.language.std).

  proves(heron.language.std.embedded_copy) {
    verify("internal/core/resolve/resolve_test.go", test = "TestStdPackagesResolve")
  }

  proves(heron.language.std.checked_like_any) {
    verify("internal/core/check/std_test.go", test = "TestEveryStdPackageChecks")
  }

  proves(heron.language.std.docs.lens_mark_from_doc) {
    verify("internal/core/lens/lens_test.go", test = "TestStandardLensesInStd")
  }

  proves(heron.language.std.docs.standard_lenses_in_std) {
    verify("internal/core/lens/lens_test.go", test = "TestStandardLensesInStd")
  }
}
