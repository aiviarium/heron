tools_docs_schema: section {
  | The tests that prove the requirements of the spec's [Reference](#heron.tools.docs.reference): its parts, the schema reference's pages, a type page's views, the agent export's schema files and the site's marks.

  proves(heron.tools.docs.reference.parts.reference_parts) {
    verify("internal/tools/docs/schema_test.go", test = "TestReferenceParts")
  }

