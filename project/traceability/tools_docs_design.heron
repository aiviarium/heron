tools_docs_design: section {
  | The tests that prove the requirements of the spec's [design system](#heron.tools.docs.design_system), [writing](#heron.tools.docs.writing) and [reference screens](#heron.tools.docs.screens).

  proves(heron.tools.docs.design_system.typography.prose_in_code) {
    verify("internal/tools/docs/lenses_test.go", test = "TestProseInCode")
  }

  proves(heron.tools.docs.design_system.tokens.one_source) {
    verify("web/tokens/tokens_test.go", test = "TestGeneratedFilesAreCurrent")
  }

  proves(heron.tools.docs.design_system.tokens.readable_contrast) {
    verify("web/tokens/tokens_test.go", test = "TestContrast")
  }

  proves(heron.tools.docs.design_system.tokens.untinted) {
