  }

  proves(heron.language.data.encodings.json.json_encode) {
    verify("internal/core/eval/eval_test.go", test = "TestJSONEncode")
  }

  proves(heron.language.data.encodings.json.json_decode) {
    verify("internal/core/eval/eval_test.go", test = "TestProcessesAndFiles")
    verify("internal/core/eval/eval_test.go", test = "TestDeclaredErrorTypes")
  }

  proves(heron.language.data.types.error_inheritance) {
    verify("internal/core/types/model_test.go", test = "TestErrorKind")
  }

  proves(heron.language.data.types.throws_covers_extensions) {
