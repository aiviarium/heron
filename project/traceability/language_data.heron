  proves(heron.language.data.types.extends_acyclic, heron.language.data.types.errors.extends_cycle) {
    verify("internal/core/types/model_test.go", test = "TestErrorKind")
  }

  proves(heron.language.data.types.members_kept, heron.language.data.types.errors.retyped_member) {
