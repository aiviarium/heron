  }

  proves(heron.language.data.configuration.scopes_amend) {
    verify("internal/core/resolve/resolve_test.go", test = "TestMapsMergeAndAssignReplaces")
  }

  proves(heron.language.data.configuration.maps_merge) {
    verify("internal/core/resolve/resolve_test.go", test = "TestMapsMergeAndAssignReplaces")
  }

  proves(heron.language.data.configuration.layering) {
    verify("internal/core/resolve/resolve_test.go", test = "TestLaterAmendWinsWhenIncluded")
  }

  proves(heron.language.data.configuration.locals_not_amended) {
    verify("internal/core/resolve/resolve_test.go", test = "TestLocalsAreVisibleBelowOnly")
  }

  proves(heron.language.data.configuration.typed_configuration) {
    verify("internal/core/types/types_test.go", test = "TestErrors")
  }

