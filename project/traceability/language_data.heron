language_data: section {
  | The tests that prove the requirements of the spec's [language.data](#heron.language.data).

  proves(heron.language.data.typed_strings.parsed_where_expected) {
    verify("internal/core/types/types_test.go", test = "TestErrors")
  }

  proves(heron.language.data.typed_strings.parsers_by_path) {
    verify("internal/core/types/typed_strings_test.go", test = "TestTypedStrings")
  }

