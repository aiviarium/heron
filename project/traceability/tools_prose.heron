tools_prose: section {
  | The tests that prove the requirements of the spec's [tools.prose](#heron.tools.prose).

  proves(heron.tools.prose.vale.vale_binary) {
    verify("internal/tools/prose/prose_test.go", test = "TestValeConfiguration")
  }

  proves(heron.tools.prose.vale.vale_config) {
    verify("internal/tools/prose/prose_test.go", test = "TestValeConfiguration")
  }

  proves(heron.tools.prose.vale.config_as_is) {
    verify("internal/tools/prose/prose_test.go", test = "TestValeConfiguration")
  }

  proves(heron.tools.prose.vale.html_projection) {
    verify("internal/tools/prose/prose_test.go", test = "TestValeAlertsMapToWords")
  }

  proves(heron.tools.prose.vale.vale_call) {
    verify("internal/tools/prose/prose_test.go", test = "TestValeAlertsMapToWords")
  }

  proves(heron.tools.prose.vale.vale_failure) {
    verify("internal/tools/prose/prose_test.go", test = "TestValeAlertsMapToWords")
  }

  proves(heron.tools.prose.vale.alert_mapping) {
    verify("internal/tools/prose/prose_test.go", test = "TestValeAlertsMapToWords")
  }

  proves(heron.tools.prose.vale.alert_fixes) {
    verify("internal/tools/prose/prose_test.go", test = "TestValeAlertsMapToWords")
  }

  proves(heron.tools.prose.vale.suggestions_not_applied) {
    verify("internal/core/cli/fix_test.go", test = "TestFixSkipsSuggestions")
  }

  proves(heron.tools.prose.vale.vale_cache) {
    verify("internal/tools/prose/prose_test.go", test = "TestVocabularyActionsAndCaching")
  }

  proves(heron.tools.prose.vale.vocabulary_edit) {
    verify("internal/tools/prose/prose_test.go", test = "TestVocabularyActionsAndCaching")
  }

  proves(heron.tools.prose.vale.setup_pin) {
    verify("scripts/e2e-setup.sh")
  }

  proves(heron.tools.prose.vale.setup_moved) {
    verify("scripts/e2e-setup.sh")
  }

  proves(heron.tools.prose.vale.setup_missing) {
    verify("scripts/e2e-setup.sh")
  }

  proves(heron.tools.prose.vale.diagnostics.vale_alert) {
    verify("internal/tools/prose/prose_test.go", test = "TestValeAlertsMapToWords")
  }

  proves(heron.tools.prose.vale.diagnostics.vale_failed) {
    verify("internal/tools/prose/prose_test.go", test = "TestValeAlertsMapToWords")
  }

  proves(heron.tools.prose.spec_lints.by_import) {
    verify("internal/tools/prose/prose_test.go", test = "TestSpecLints")
  }

  proves(heron.tools.prose.spec_lints.spec_cache) {
    verify("internal/tools/prose/prose_test.go", test = "TestSpecLints")
  }
}
