cli_lint: section {
  | The tests that prove the requirements of the spec's [cli.lint](#heron.cli.lint).

  proves(heron.cli.lint.any_finding_fails) {
    verify("internal/core/cli/check_test.go", test = "TestSampleLint")
  }

  proves(heron.cli.lint.fix_applies_no_guess) {
    verify("internal/core/cli/fix_test.go", test = "TestFixSkipsSuggestions")
  }

  proves(heron.cli.lint.fix_no_overlap) {
    verify("internal/core/cli/fix_test.go", test = "TestFixSkipsOverlaps")
  }

  proves(heron.cli.lint.fix_in_place) {
    verify("internal/core/cli/fix_test.go", test = "TestFixSkipsOverlaps")
  }
}
