tools_server_api: section {
  | The tests that prove the requirements of the spec's [server API](#heron.tools.server_api), of what
  | [the server](#heron.tools.server) does with it, of the [API reference](#heron.tools.docs.screens.api_page),
  | [AsyncAPI](#heron.tools.asyncapi) and the [TextMate grammar](#heron.tools.tree_sitter.textmate).

  proves(heron.tools.server.serving.json_wire) {
    verify("internal/tools/server/api_test.go", test = "TestNoOp")
  }

  proves(heron.tools.server.serving.compressed_assets) {
    verify("internal/tools/server/api_test.go", test = "TestCompressedAssets")
  }

  proves(heron.tools.server.serving.loopback_default) {
    verify("internal/tools/server/loopback_test.go", test = "TestLoopback")
    verify("internal/tools/server/server_test.go", test = "TestServeCommand")
  }

  proves(heron.tools.server.serving.non_loopback_warning) {
    verify("internal/tools/server/loopback_test.go", test = "TestLoopback")
  }

  proves(heron.tools.server.serving.same_origin) {
    verify("internal/tools/server/api_test.go", test = "TestOrigins")
  }

  proves(heron.tools.lsp.extensions.workspace_uris) {
    verify("internal/tools/lsp/features_test.go", test = "TestHoverShowsDocs")
  }

  proves(heron.tools.server_api.no_such_file) {
    verify("internal/tools/server/codes_test.go", test = "TestErrorCodes")
  }

  proves(heron.tools.server_api.no_op) {
    verify("internal/tools/server/api_test.go", test = "TestNoOp")
  }

  proves(heron.tools.server_api.origin_not_allowed) {
    verify("internal/tools/server/api_test.go", test = "TestOrigins")
  }

  proves(heron.tools.docs.screens.api_page.lead.api_facts) {
    verify("internal/tools/docs/apiref_test.go", test = "TestAPILanding")
  }

  proves(heron.tools.docs.screens.api_page.ops.ops_grouped) {
    verify("internal/tools/docs/apiref_test.go", test = "TestAPILanding")
  }

  proves(heron.tools.docs.screens.api_page.ops.one_line_each) {
    verify("internal/tools/docs/apiref_test.go", test = "TestAPILanding")
  }

  proves(heron.tools.docs.screens.api_page.types.types_listed) {
    verify("internal/tools/docs/apiref_test.go", test = "TestAPILanding")
  }

  proves(heron.tools.docs.screens.op_page.body.trace.realized_shown) {
    verify("internal/tools/docs/apiref_test.go", test = "TestOpPageOutcomes")
  }

  proves(heron.tools.docs.screens.op_page.body.trace.deprecated_shown) {
    verify("internal/tools/docs/apiref_test.go", test = "TestOpPageOutcomes")
    verify("internal/tools/docs/apiref_test.go", test = "TestAPILanding")
  }

  proves(heron.tools.docs.screens.op_page.body.responses.error_projections) {
    verify("internal/tools/docs/apiref_test.go", test = "TestOpPageOutcomes")
  }

  proves(heron.tools.docs.screens.op_page.examples.json_messages) {
    verify("internal/tools/docs/apiref_test.go", test = "TestOpPageOutcomes")
  }

  proves(heron.tools.docs.screens.op_page.examples.served_try_it) {
    verify("internal/tools/docs/apiref_test.go", test = "TestServedTryIt")
  }

  proves(heron.tools.docs.screens.op_page.examples.static_try_it) {
    verify("internal/tools/docs/apiref_test.go", test = "TestServedTryIt")
  }

  proves(heron.tools.asyncapi.asyncapi_target) {
    verify("internal/tools/docs/asyncapi_test.go", test = "TestAsyncAPI")
  }

  proves(heron.tools.asyncapi.asyncapi_channels) {
    verify("internal/tools/docs/asyncapi_test.go", test = "TestAsyncAPI")
  }

  proves(heron.tools.asyncapi.asyncapi_schemas) {
    verify("internal/tools/docs/asyncapi_test.go", test = "TestAsyncAPI")
  }

  proves(heron.tools.asyncapi.asyncapi_extra) {
    verify("internal/tools/docs/asyncapi_test.go", test = "TestAsyncAPI")
  }

  proves(heron.tools.tree_sitter.textmate.textmate_published) {
    verify("internal/tools/textmate/textmate_test.go", test = "TestPublishedGrammarsAreCurrent")
  }

  proves(heron.tools.tree_sitter.textmate.textmate_scopes) {
    verify("internal/tools/textmate/textmate_test.go", test = "TestScopesAndPatterns")
    verify("internal/tools/textmate/textmate_test.go", test = "TestScopedSamples")
  }
