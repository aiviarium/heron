tools_tree_sitter: section {
  | The tests that prove the requirements of the spec's [tools.tree_sitter](#heron.tools.tree_sitter).

  proves(heron.tools.tree_sitter.query_files.queries_compile) {
    verify("grammar/tree-sitter-heron/test-fixtures.sh")
  }

  proves(heron.tools.tree_sitter.query_files.highlight_scope) {
    verify("grammar/tree-sitter-heron/test-fixtures.sh")
  }

  proves(heron.tools.tree_sitter.query_files.short_links_captured) {
    verify("grammar/tree-sitter-heron/test/corpus/heron.txt")
    verify("grammar/tree-sitter-heron/test-fixtures.sh")
  }

  proves(heron.tools.tree_sitter.query_files.elements_captured) {
    verify("grammar/tree-sitter-heron/test/corpus/heron.txt")
    verify("grammar/tree-sitter-heron/test-fixtures.sh")
  }
}
