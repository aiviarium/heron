// The types the server's ops name.

/// What the preview renders: the files being edited, as typed, and where
/// the cursor is.
PreviewRequest: type {
  /// The file the cursor is in, relative to the workspace.
  file: String
  /// The byte offset of the cursor in that file.
  offset: Int
  /// Unsaved text of open files, by path relative to the workspace.
  overlays: Map(String, String)
}

/// The current node as the docs render it.
Preview: type {
  /// The node's path in the tree; empty for the file itself.
  path: String
  /// Its kind, which picks the renderer.
  kind: String
  html: String
  /// The error that stopped the render, shown in place.
  error?: String
  /// A generated file, shown as it would be written.
  generated?: GeneratedFile
  results: NodeResults
}

/// A generated file as it would be written.
GeneratedFile: type {
  path: String
  text: String
}

/// The latest records for a node and its children, from whichever units
/// provide them.
NodeResults: type {
  path: String
  results: List(NodeResult)
}

/// One result beside a node, such as a task's last run.
NodeResult: type {
  /// The provider that made it, such as `run`.
  source: String
  /// The node it belongs to.
  path: String
  /// `ok`, `failed` or `running`.
  status: String
  /// A short value for the gutter, such as a duration.
  summary: String
  record_id?: String
  time?: String
}

/// A stored record.
Record: type {
  kind: String
  id: String
  time: String
  data: Any
}

/// One message of the language server protocol, as JSON text.
LspMessage: type {
  json: String
}

/// The repository the server runs on.
Workspace: type {
  name: String
  /// The folder on disk, which language-server URIs start with.
  root: String
  /// The entry point, relative to the workspace.
  entry: String
  branch: String
  files: List(String)
}

/// A file's text, by path relative to the workspace.
FileText: type {
  path: String
  text: String
}

Saved: type {
  path: String
}

/// The tree with the given unsaved texts.
TreeRequest: type {
  overlays: Map(String, String)
}

/// The tree's diagnostics.
Problems: type {
  problems: List(Problem)
}

/// One diagnostic, with 1-based lines and columns.
Problem: type {
  file: String
  line: Int
  column: Int
  end_line: Int
  end_column: Int
  severity: String
  code: String
  message: String
  /// What reported it, such as `check` or `lint`.
  source: String
}

/// Runs a task by its path.
RunRequest: type {
  path: String
}

/// One step of a run: output while it runs, then its result.
RunEvent: type {
  /// `output` or `done`.
  type: String
  text?: String
  result?: NodeResult
}

/// What `heron generate` would write, without writing it.
GeneratedFiles: type {
  files: List(GeneratedFile)
}

/// A file of the tree with the given unsaved texts.
OutlineRequest: type {
  file: String
  overlays: Map(String, String)
}

/// The nodes a file declares, in reading order.
Outline: type {
  file: String
  nodes: List(OutlineNode)
}

/// A node and the lines it spans, 1-based.
OutlineNode: type {
  path: String
  name: String
  kind: String
  depth: Int
  line: Int
  end_line: Int
  /// Whether it can be run from the gutter.
  runnable: Bool
}
