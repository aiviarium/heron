// A small product spec with authored pages and every lens, for the lens
// and authored-kind tests and the docs screenshots.
import = ["std/schema@1", "std/doc@1", "std/types@1", "std/http@1", "std/docs@1"]

kite: package(version = "1.4.0") {
  @lens(user)
  | Kite syncs a folder of notes to a remote store. It runs as one command, `kite`, and
  | keeps a log of every sync it makes.

  @lens(developer, explore)
  | The spec of Kite 1.4: what a sync copies, its errors and its command line.

  system: section {
    syncer: part {{ The part of Kite that copies notes to the store. }}
    writer: actor {{ Someone who keeps notes in a folder. }}
  }

  start: guide {
    | Install Kite, point it at a folder and run your first sync. This takes about five
    | minutes and needs a store you can write to.
    |
    | Kite reads its settings from `kite.toml` in the folder it syncs. The
    | [sync command](#kite.cli.sync), ${kite.cli.sync.name}, does the work; its `--dry-run` option defaults to
    | ${kite.cli.sync.dry_run}, so a first run changes nothing until you say so.

    first_config: example {
      | ```text
      | store = "s3://notes"
      | interval = "5m"
      | ```
    }

    @lens(user)
    | When the sync finishes, Kite prints the number of notes it copied.
  }

  set_up_store: howto {
    | Connect Kite to a new store and check that it can write there.

    create: step {
      | Create a bucket or a folder for the notes, and give Kite's key write access to it.
    }

    point: step {
      | Add the store's address to `kite.toml`:

      store_line: example {
        | ```text
        | store = "s3://notes"
        | ```
      }
    }

    check: step {
      | Run `kite sync --dry-run`. Kite lists what it would copy and changes nothing.
    }
  }

  first_sync: tutorial {
    | Build a notes folder from nothing and keep it in sync.

    folder: step {{ Make a folder and write a note in it. }}
    run: step {{ Run `kite sync` and watch the log. }}
  }

  more: section {
    @lens(user)
    | More pages for people who sync notes.

    @lens(user)
    tips: concept {
      | Keep the folder small: Kite copies changed notes only, so a large folder syncs as
      | fast as a small one. A [conflict] needs you, and [`cli.sync`] with `--dry-run` previews a sync, as does
      | the [store_line] step.
    }
  }

  conflicts: concept {
    | A [conflict](#kite.sync.conflict) happens when a note changed in the folder and in the
    | store since the last sync. Kite keeps both copies and tells you which ones to merge,
    | as [the conflict rule](#kite.sync.keeps_both) says.
  }

  sync: section {
    | How a sync decides what to copy.

    conflict: term {{ A note changed in two places since the last sync. }}

    copies_changed: rule(kite.system.syncer) {
      must {{ copy every note whose content changed since the last sync }}
      then {{ a note that only moved is renamed in the store, not copied again }}
    }

    keeps_both: rule(kite.system.syncer) {
      when {{ a note changed in the folder and in the store }}
      must {{ keep both copies, the store's under a `.conflict` suffix }}
      while {{ the two copies differ }}
    }

    logs_each: rule(kite.system.syncer) {
      must {{ append a line to the sync log for every note it copies }}
      then {{ the log grows with each sync, so it's rotated once it reaches 1 MB }}
    }

    retries: section {
      | How a sync retries a store that doesn't answer.

      backoff: section {
        | How long a sync waits between tries.

        backoff_doubles: rule(kite.system.syncer) {
          must {{ double the wait after each failed try, up to five minutes }}
        }

        wait: term {{ The time a sync waits before it tries the store again. }}
      }
    }

    no_deletes: rule(kite.system.syncer) {
      must_not {{ delete a note from the store }}
      instead {{ move it to the store's `trash/` folder }}
      example {{ removing `ideas.md` locally moves it to `trash/ideas.md` }}
    }

    @lens(developer)
    | Spec writers: every rule here names the syncer, whose behaviour it states.

    unreadable: error(422) {
      title = "can't read {file}"
      file: String
      | A note Kite can't read, such as one without read permission.
    }

    unlistable: error(422, id = "unreadable") {
      title = "can't list <{folder}>"
      folder: String
      | A folder Kite can't list, so none of its notes sync.
    }

    store_down: error<warning>(422, id = "store-unreachable") {
      title = "the store at {address} doesn't answer"
      address: String
      | The store didn't answer within the timeout; Kite retries at the next interval.
    }

    same_everywhere: goal {{ A note reads the same in the folder and in the store. }}
  }

  /// A note as the store keeps it.
  Note: type {
    id: String
    /// The note's path in the folder, as `ideas/kite.md`.
    path: String
    updated_at: Timestamp
    conflicted: Bool = false
  }

  /// No note has the id.
  NoteNotFound: error(404) {
    title = "No note has the id {id}."
    id: String
  }

  /// The store's HTTP interface, which Kite syncs through.
  @http(base_path = "/v1")
  store_api: api {
    @http<get>("/notes/:id")
    @throws(NoteNotFound)
    get_note(@path id: String): op(Note, gone_notes) {
      | Returns one note, with the time it last changed.

      one_note: example {
        id = "n1"
        returns = Note(id = "n1", path = "ideas/kite.md", updated_at = "2026-11-02T09:00:00Z")
      }
    }

    @http<put>("/notes/:id")
    @throws(note_locked)
    put_note(@path id: String, @body note: Note): op(Note) {
      | Writes one note, replacing the store's copy.
    }

    @http<get>("/notes")
    list_notes(): op<deprecated>(List(Note)) {
      | Lists every note. Use the sync log instead.
    }
  }

  note_locked: error(423, id = "store.NOTE_LOCKED") {
    title = "{id} is being written by another sync"
    id: String
    | Reported as [gone_notes] says.
  }

  gone_notes: rule(kite.system.syncer) {
    when {{ the store answers 404 }}
    must {{ report the note as gone and keep the local copy }}
  }

  @display("CLI")
  cli: section {
    sync(
      /// Lists what a sync would copy without copying it.
      @option
      dry_run: Bool = false,
      /// The folder to sync; `.` unless given.
      folder?: String,
    ): command("kite sync") {
      | Syncs a folder with its store, once.

      | Exits 0 when the sync finished.

      exit_1: error(422, id = "kite sync exit 1") {
        title = "a note couldn't be copied"
        | Reported as [cli.sync.exits_nonzero] says.
      }

      exits_nonzero: rule(kite.system.syncer) {
        must {{ exit with status 1 when any note couldn't be copied }}
      }
    }
  }

  sync_notes: usecase(kite.system.writer) {
    | A writer syncs their notes.
    |
    | 1. [kite.system.writer] runs `kite sync`.
    | 2. [kite.system.syncer] copies the changed notes.
    | 3. [kite.system.syncer] logs what it copied.
    |
    | - 2a. The store doesn't answer:
    |   [kite.system.syncer] retries at the next interval. Back to 2.
    | - 2b. A note can't be read:
    |   [kite.system.syncer] skips it and reports it. Fails.

    success {{ The store holds every note. }}
  }
}

docs {
  depth = 3
  lenses = [user, developer, explore]
}
