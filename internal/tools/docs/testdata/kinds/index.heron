// The kinds of std/spec's layers, std/grammar and std/project, each once,
// for the renderer tests.
import = ["std/doc@1", "std/spec@1", "std/grammar@1", "std/project@1"]

@source("authors")
trust: goal(measure = "Nine trees in ten check clean on the first CI run.") {{ Authors ship a spec their team trusts. }}

people: section {
  writer: actor {{ Someone who writes Heron. }}
  ci: actor(kind = ActorKind.SYSTEM) {{ The build server. }}

  maya: persona(plays = people.writer) {
    goals =| Ship a spec her team trusts.
    | A staff engineer.
  }

  no_hosting: nongoal {{ Hosting the docs. }}
}

checker: part {{ Reads a tree and reports what breaks it. }}

editing: section {
  | Writing Heron in an editor.

  check_tree: usecase(actor = people.writer, success = "A tree that checks clean.", minimal = "No file changes.") {{
    The writer checks a tree.

    1. [people.writer] runs `heron check`.
    2. [checker] parses every file.
    3. [checker] reports no errors.

    - 2a. A file can't be read:
      [checker] exits 2. Fails.
    - 3a. The tree has errors:
      [people.writer] fixes them. Back to 1.
  }}

  @realizes(editing.check_tree.2a)
  @by(checker)
  @exit(2)
  unreadable: error("unreadable") {
    title = "can't read {path}"
    path: field(String)
  }

  @illustrates(guarantees.parse_all)
  saved: scenario {
    given {{ a file with a type error }}
    given {{ the language server running }}
    when {{ the writer saves the file }}
    then {{ the error is underlined }}
  }
}

@serves(trust)
see_errors: story<planned>(adds = [guarantees.parse_all]) {
  done {{ The team has tried it. }}
}

unit_one: increment<delivered>(see_errors) {
  | First cut.
}

runtime: section {
  syntax: component(path = "internal/core/syntax", lang = "go") {
    | The lossless parser.
    uses = []

    lossless: responsibility {{ Parse every byte into a tree that prints back exactly. }}

    /// Parse reads one file.
    exports(title = "parse.go") {{
      func Parse(src []byte) *Node
    }}

    no_io: property {
      mustNot {{ import `os` or any other package that does I/O }}
    }
  }

  resolve: component(path = "internal/core/resolve", lang = "go") {
    uses = [runtime.syntax]
  }
}

cli: section {
  check: command("heron check") {
    | Checks a tree.
    usage = ["heron check [--json] [path…]"]
    errors = [editing.unreadable]
    argument("path", type = String, optional = true, variadic = true) {{ An entry point or folder. }}
    option("--json", type = Bool, default = false) {{ Print diagnostics as JSON lines. }}
    example {{
      ```sh
      heron check spec
      ```
    }}
  }
}

lang: section {
  @source("grammar/heron.ungram")
  core: grammar(notation = "ebnf") {
    start = lang.core.file
    /// The implicit root of a file.
    file: production {{ member* }}
    member: production {{ (doc | annotation)* declare | comment }}
    declare: production {{ name ":" type body? }}
    name: token {{ [A-Za-z_][A-Za-z0-9_]* }}
    comment: token {{ "//" [^\n]* }}
  }
}

guarantees: section {
  @by(checker)
  @serves(trust)
  @rationale("A file left unread hides its errors.")
  parse_all: rule {
    must {{ read every file }}
  }

  @by(people.writer)
  writer_saves: rule {
    should {{ save before running a task }}
  }
}

op_page: screen(route = "/docs/<op>") {
  | An API op page.

  top_bar: region {
    | The logo, the sections, search and the theme switch.
  }

  body: region {
    | The op's docs.

    facts: region {{ The transition it performs and its limits. }}
  }
}

tables: section {
  | | Writing        | Means                |
  | | -------------- | -------------------- |
  | | `T \| null`    | the value or null    |
  | | a \| b         | either               |
}
