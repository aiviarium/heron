{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{{", "}}"],
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["`", "`"]
  ],
  "folding": {
    "offSide": true
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "(\\{\\{|[{\\[(])\\s*$",
    "decreaseIndentPattern": "^\\s*(\\}\\}|[}\\])])"
  },
  "onEnterRules": [
    {
      "beforeText": "(\\{\\{|[{\\[(])\\s*$",
      "afterText": "^\\s*(\\}\\}|[}\\])])",
      "action": { "indent": "indentOutdent" }
    }
  ]
}
