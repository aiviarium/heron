{
  "name": "@heron/runtime",
  "version": "0.1.0",
  "description": "The TS SDK and JS host of Heron's extension protocol.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./apis": {
      "types": "./dist/apis.d.ts",
      "default": "./dist/apis.js"
    },
    "./protocol": {
      "types": "./dist/protocol.gen.d.ts",
      "default": "./dist/protocol.gen.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    }
  },
  "bin": {
    "heron-js-host": "./dist/host-main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.sparrow.json",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aiviarium/sparrow": "link:../sparrow/ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
