// A sample package whose parts are implemented in TS: a foreign func, a
// transport (bound to an api by an annotation of this package), a lint, a resource driver and a generation adapter. Each is
// declared here, so it's checked, completed and documented like a built-in
// part, and `heron generate ts` writes the types its implementation is
// checked against.
import = ["std/schema@1", "std/types@1", "std/js@1", "std/apis@1"]

inventory: package(version = "1.0") {
  impl: module = js("./src/index.ts")

  /// One line of the inventory.
  Item: type {
    sku: String
    name: String
    count: Int
  }

  /// What an instance of the store resource is.
  Store: type {
    items: List(Item)
  }

  /// Turns a name into a slug.
  slugify(text: String): func<pure>(String) = impl.slugify

  /// Counts an item in the store, or 0 when it isn't there.
  count(sku: String): func(Int) = impl.count

  /// An in-memory store of items, seeded with two.
  store: resource(Store) = impl.store

  /// Sends an op's requests to the in-memory store.
  memory: transport = js("./src/transport.ts")

  /// Binds an api, or one of its ops, to the memory transport.
  in_memory: annotation(on = [types.api, types.op])

  /// What the memory transport answers for one lookup.
  Lookup: type {
    op: String
    found: Bool
    item?: Item
  }

  /// Looks items up in the store; its calls go through the memory transport.
  @in_memory
  shelf: api {
    /// Finds an item by its SKU.
    find(sku: String): op(Lookup)
  }

  /// Labels an item with its count, in Heron.
  label(name: String, count: Int): func(String) = "$name ($count)"

  /// Describes an item: looks it up through the shelf api and labels it,
  /// both from TS through ctx.call.
  describe(sku: String): func(String) = impl.describe

  /// Reports nodes whose prose still says TODO.
  no_todo: lint = impl.noTodo

  /// Writes a catalog of the tree's types.
  catalog: generator(target = "catalog") = impl.catalog
}
