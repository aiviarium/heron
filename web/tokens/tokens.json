{
  "$comment": "The one set of design tokens for the app, the editors and the docs theme. Edit this file, then run `go generate ./web/tokens`. Every name becomes the CSS variable --h-<name> and a key of the TS export.",
  "color": {
    "bg-page":        { "dark": "#111111", "light": "#ffffff", "role": "surface" },
    "bg-raised":      { "dark": "#181818", "light": "#fafafa", "role": "surface" },
    "bg-soft":        { "dark": "#1f1f1f", "light": "#f3f3f3", "role": "surface" },
    "bg-highlight":   { "dark": "#292929", "light": "#e9e9e9", "role": "surface" },
    "bg-topbar":      { "dark": "rgba(17, 17, 17, 0.78)", "light": "rgba(255, 255, 255, 0.8)", "role": "none" },
    "bg-button":      { "dark": "#262626", "light": "#ededed", "role": "none" },
    "bg-button-hover":{ "dark": "#303030", "light": "#e3e3e3", "role": "none" },

    "border-faint":   { "dark": "rgba(255, 255, 255, 0.06)", "light": "rgba(0, 0, 0, 0.06)", "role": "none" },
    "border":         { "dark": "rgba(255, 255, 255, 0.10)", "light": "rgba(0, 0, 0, 0.10)", "role": "none" },
    "border-strong":  { "dark": "rgba(255, 255, 255, 0.17)", "light": "rgba(0, 0, 0, 0.17)", "role": "none" },

    "text":           { "dark": "#ededed", "light": "#171717", "role": "text" },
    "text-secondary": { "dark": "#a8a8a8", "light": "#545454", "role": "text" },
    "text-faint":     { "dark": "#949494", "light": "#666666", "role": "text" },
    "text-decor":     { "dark": "#4d4d4d", "light": "#c2c2c2", "role": "none" },
    "text-on-primary":{ "dark": "#111111", "light": "#ffffff", "role": "none" },

    "accent":         { "dark": "#a99cf7", "light": "#5b45cc", "role": "mark" },
    "accent-line":    { "dark": "rgba(169, 156, 247, 0.45)", "light": "rgba(91, 69, 204, 0.4)", "role": "none" },

    "status-ok":      { "dark": "#4fc785", "light": "#18794a", "role": "mark" },
    "status-warn":    { "dark": "#e5a83b", "light": "#9a5b05", "role": "mark" },
    "status-error":   { "dark": "#f2777a", "light": "#c4282b", "role": "mark" },
    "status-info":    { "dark": "#6aa9f5", "light": "#1f62c4", "role": "mark" },
    "type":           { "dark": "#4ec6c0", "light": "#0b7671", "role": "mark" },

    "syntax-keyword":    { "alias": "accent" },
    "syntax-string":     { "alias": "status-ok" },
    "syntax-number":     { "alias": "status-warn" },
    "syntax-type":       { "alias": "type" },
    "syntax-annotation": { "alias": "status-info" },
    "syntax-comment":    { "alias": "text-faint" },
    "syntax-punct":      { "alias": "text-secondary" },
    "syntax-name":       { "alias": "text" },
    "syntax-error":      { "alias": "status-error" },

    "method-get":     { "alias": "status-info" },
    "method-post":    { "alias": "status-ok" },
    "method-put":     { "alias": "status-warn" },
    "method-patch":   { "alias": "status-warn" },
    "method-delete":  { "alias": "status-error" },

    "shadow-overlay": { "dark": "0 8px 28px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.08)", "light": "0 8px 28px rgba(0, 0, 0, 0.12), 0 0 0 1px rgba(0, 0, 0, 0.08)", "role": "none" },
    "bg-backdrop":    { "dark": "rgba(0, 0, 0, 0.55)", "light": "rgba(0, 0, 0, 0.28)", "role": "none" },
    "dot-grid":       { "dark": "rgba(255, 255, 255, 0.07)", "light": "rgba(0, 0, 0, 0.09)", "role": "none" }
  },
  "size": {
    "control-sm": "24px",
    "control":    "28px",
    "control-lg": "32px",
    "row":        "28px",
    "topbar":     "44px",
    "sidebar":    "248px",
    "aside":      "300px",
    "measure":    "570px",
    "border":     "1px",
    "focus":      "2px"
  },
  "radius": {
    "mark":    "4px",
    "control": "6px",
    "card":    "8px",
    "overlay": "10px"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "font": {
    "sans": "Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "mono": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
    "size-ui":    "13px",
    "size-prose": "15px",
    "size-code":  "12.5px",
    "size-label": "11px",
    "size-h1":    "28px",
    "size-h2":    "20px",
    "size-h3":    "16px",
    "line-ui":    "20px",
    "line-prose": "1.65",
    "line-code":  "1.6",
    "weight-regular":  "400",
    "weight-medium":   "500",
    "weight-semibold": "600",
    "tracking-heading": "-0.012em",
    "tracking-label":   "0.01em"
  },
  "motion": {
    "fast": "120ms",
    "base": "160ms",
    "slow": "200ms",
    "ease": "cubic-bezier(0.2, 0, 0, 1)"
  }
}
