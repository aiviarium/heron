// std/product: who a system is for and what they need from it, in the
// agile forms a team plans with: actors and personas, epics of stories
// with acceptance criteria, use cases with numbered flows, increments and
// milestones, and what done means. Criteria read given, when and then,
// with std/spec's `when` and `then`.
import = ["std/schema@1", "std/types@1", "std/doc@1", "std/spec@1", "std/tech@1"]

product: package(version = "1.0", requires = ["std/doc@1", "std/spec@1", "std/tech@1"]) {
  // --- Who ---

  /// What kind of party an actor is.
  ActorKind: enum {
    /// A person using the system.
    PERSON: Self
    /// Another program, called by or calling the system.
    SYSTEM: Self
    /// An AI agent acting for a person.
    AGENT: Self
  }

  /// A party that uses the system or that the system uses.
  actor(kind: ActorKind = ActorKind.PERSON): kind(in = [block]) {
    accept(prose)
  }

  /// A typical person behind an actor: their context, goals and pains.
  persona(of: Ref(actor)): kind(in = [block]) {
    /// What the persona wants to get done.
    goals?: Prose
    /// What gets in their way today.
    pains?: Prose
    accept(prose)
  }

  // --- What they need ---

  /// A large body of work for one outcome, split into stories and use
  /// cases.
  epic(owner?: String): kind(in = [block]) {
    accept(prose)
    accept(kind = story)
    accept(kind = usecase)
    accept(kind = done, max = 1)
    accept(category = block)
  }

  /// One need of one actor, small enough to build in an increment: as the
  /// actor, I want what `want` says, so that what `so` says.
  story(as: Ref(actor)): kind(in = [block]) {
    want: Prose
    so?: Prose
    accept(prose)
    accept(kind = criterion)
  }

  /// One acceptance criterion: the givens, the event and what follows.
  criterion: kind(in = [block]) {
    accept(prose)
    accept(kind = given)
    accept(kind = spec.when, max = 1)
    accept(kind = spec.then)
  }

  /// A state a criterion starts from.
  given: kind {
    accept(prose)
  }

  /// How an actor reaches one goal with the system, step by step, and
  /// what happens when a step goes another way. Its own steps are the main
  /// success flow, numbered in order.
  usecase(actor: Ref(actor), supporting?: List(Ref(actor))): kind(in = [block]) {
    /// What the actor wants at the end.
    goal?: Prose
    accept(prose)
    accept(kind = precondition)
    accept(kind = step)
    accept(kind = alternate)
    accept(kind = failure)
    accept(kind = postcondition)
  }

  /// What holds before a use case starts.
  precondition: kind {
    accept(prose)
  }

  /// What holds once a use case ends; `on_failure` for a failure's end.
  postcondition(on_failure?: Bool): kind {
    accept(prose)
  }

  /// A flow that branches off a step and still reaches the goal,
  /// numbered after its step, as 3a. `rejoins` is the step it returns to;
  /// without it the use case ends.
  alternate(at: Ref(step), rejoins?: Ref(step)): kind {
    accept(prose)
    accept(kind = step)
  }

  /// A flow that branches off a step and fails the goal.
  failure(at: Ref(step)): kind {
    accept(prose)
    accept(kind = step)
  }

  /// One step of a flow: who does what. Name a step to branch off it.
  step: kind {
    accept(prose)
  }

  // --- When ---

  /// A shippable slice of the system that delivers stories.
  increment(delivers<variadic>?: Ref(Any)): kind(in = [block]) {
    accept(prose)
    accept(kind = done, max = 1)
    accept(category = block)
  }

  /// A point in time the work is measured against.
  milestone(reached_by<variadic>?: Ref(Any)): kind(in = [block]) {
    accept(prose)
    accept(kind = done, max = 1)
  }

  /// What done means for its parent: criteria the build is accepted by.
  done: kind(in = [block]) {
    accept(prose)
    accept(kind = criterion)
  }

  /// Where a piece of work stands. `planned` also marks a rule, a
  /// component or a diagnostic written ahead of its code.
  planned: flag(on = [epic, story, usecase, increment, milestone, spec.rule, tech.component, tech.diagnostic], group = "status")
  started: flag(on = [epic, story, usecase, increment, milestone], group = "status")
  delivered: flag(on = [epic, story, usecase, increment, milestone], group = "status")
  deferred: flag(on = [epic, story, usecase, increment, milestone], group = "status")
}
