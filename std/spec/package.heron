// std/spec: the kinds a specification is written in, in its three layers:
// the intent (why a product exists and for whom), the specification (what
// must hold of it from outside) and the contract (the exact surface a
// consumer relies on), with the references between them, projects,
// lifecycles and planning. It's part of the core: every tree sees it without an
// import, as it sees std/core, apart from the packages it's written with.
// The kinds of other packages join its annotations' open sets through the
// categories below, so it never names a package that isn't core.
import = ["std/schema@1", "std/types@1", "std/doc@1"]

spec: package(version = "1.1", requires = ["std/doc@1", "std/types@1"]) {
  // --- Projects ---

  /// One unit of the system, such as a service, a library or an app.
  project(path: String): kind {
    /// The spec subtrees the project implements.
    implements?: List(Ref(Any))
    /// Narrows a subtree to part of the project, by file pattern.
    paths?: Map(String, String)
    depends_on?: List(Ref(project))
    /// Who answers for the project; reviews route by it.
    owners?: List(String)
    /// The projects this one groups.
    members?: List(Ref(project))
    /// Where an external project's code comes from.
    source?: Source
    versioning?: Versioning
    releases?: Releases
    accept(kind = task)
  }

  /// Code the system uses but doesn't own, pinned with a source.
  external: flag(on = [project])

  /// Puts every member of a group on the group's one version.
  shared: flag

  /// A checked-out source: the url, the ref as written and the commit it
  /// resolved to.
  Source: type {
    url: String
    ref?: String
    commit?: String
  }

  /// Returns a source for a git repository at a ref.
  git(url: String, ref?: String): func(Source)

  /// How a project's versions are formed.
  Versioning: type {
    scheme?: String
    bumps?: Bumps
  }

  /// What raises a version.
  Bumps: interface

  /// Versions that follow the spec: what each kind of spec change bumps.
  FromSpec: type(Bumps) {
    breaking?: String
    added?: String
    clarified?: String
  }

  /// Where a project's releases are recorded.
  Releases: type {
    changelog?: String
  }

  // --- Context ---

  security: flag(on = [section])
  privacy: flag(on = [section])
  operations: flag(on = [section])

  // --- Intent ---

  /// What kind of party an actor is.
  ActorKind: enum {
    /// A person using the system.
    PERSON: Self
    /// Another program, called by or calling the system.
    SYSTEM: Self
    /// An AI agent acting for a person.
    AGENT: Self
  }

  /// What a product is for, in the words of the people it's for, with an
  /// optional measure of success; its references name the actors or
  /// personas who asked for it. Validated, never proven by a test.
  @icon("target")
  goal(refs<variadic>?: Ref(Any), measure?: String): kind(in = [block], layer = Layer.INTENT, references = [actor, persona]) {
    accept(prose)
  }

  /// A role that crosses the system's boundary.
  @icon("user")
  actor(kind: ActorKind = ActorKind.PERSON): kind(in = [block], layer = Layer.INTENT) {
    accept(prose)
  }

  /// An archetype of a person who plays an actor.
  persona(plays: Ref(actor)): kind(in = [block], layer = Layer.INTENT) {
    /// What the persona wants to get done.
    goals?: Prose
    /// What gets in their way today.
    pains?: Prose
    accept(prose)
  }

  /// Something the product could plausibly do and deliberately doesn't.
  nongoal: kind(in = [block], layer = Layer.INTENT) {
    accept(prose)
  }

  /// What the spec relies on an actor or the environment to do.
  assumption: kind(in = [block], layer = Layer.INTENT) {
    accept(prose)
  }

  /// One of the few qualities that matter most; its quality scenarios
  /// measure it.
  quality(measure?: String): kind(in = [block], layer = Layer.INTENT) {
    accept(prose)
  }

  // --- Specification ---

  /// One behaviour in one strength node, and when it applies. A leaf: its
  /// references name what it states a fact about, at most one actor or
  /// part whose behaviour it states (without one, the system), the goals
  /// and qualities it serves and the assumptions it relies on. It never
  /// references another rule; the terms it uses are linked in its prose.
  @icon("scale")
  rule(refs<variadic>?: Ref(Any)): kind(in = [block, types.realized], layer = Layer.SPECIFICATION, references = [actor, part, goal, quality, assumption]) {
    accept(prose)
    accept(category = strength, max = 1)
    accept(kind = where, max = 1)
    accept(kind = while)
    accept(kind = when, max = 1)
    accept(kind = spec.if, max = 1)
    accept(kind = then, max = 1)
    accept(kind = instead, max = 1)
    accept(category = condition)
    accept(kind = rationale, max = 1)
    accept(kind = example)
  }

  /// A limit on the solution with a reason from outside it; its references
  /// name the goals and qualities it serves, the assumptions it relies on
  /// and the actors or personas who asked for it.
  constraint(refs<variadic>?: Ref(Any), reason?: String): kind(in = [block, types.realized], layer = Layer.SPECIFICATION, references = [goal, quality, assumption, actor, persona]) {
    accept(prose)
    accept(category = strength, max = 1)
    accept(kind = where, max = 1)
    accept(kind = while)
    accept(kind = when, max = 1)
    accept(kind = spec.if, max = 1)
    accept(kind = then, max = 1)
    accept(kind = rationale, max = 1)
    accept(kind = example)
  }

  /// A party inside the boundary that rules bind, named by its role as
  /// seen from outside. No architecture.
  part: kind(in = [block, types.realized], layer = Layer.SPECIFICATION) {
    accept(prose)
    accept(category = block)
  }

  /// The strengths a requirement states its behaviour with.
  strength: category

  /// The nodes that say when a requirement applies and what follows.
  condition: category

  must: kind(in = [strength]) {
    accept(prose)
  }

  should: kind(in = [strength]) {
    accept(prose)
  }

  may: kind(in = [strength]) {
    accept(prose)
  }

  mustNot: kind(in = [strength]) {
    accept(prose)
  }

  shouldNot: kind(in = [strength]) {
    accept(prose)
  }

  /// A trigger.
  when: kind(in = [condition]) {
    accept(prose)
  }

  /// A state.
  while: kind(in = [condition]) {
    accept(prose)
  }

  /// An optional feature.
  where: kind(in = [condition]) {
    accept(prose)
  }

  /// An unwanted situation.
  if: kind(in = [condition]) {
    accept(prose)
  }

  /// A consequence the system guarantees once the rule applies.
  then: kind(in = [condition]) {
    accept(prose)
  }

  /// Under a negative strength, the intended alternative.
  instead: kind(in = [condition]) {
    accept(prose)
  }

  /// Why a rule or a constraint holds, in a line.
  rationale: kind {
    accept(prose)
  }

  /// An outcome scenario, one case of the one rule or path of a use case it
  /// references, in given, when and then; or a quality scenario, with
  /// stimulus, environment, response and measure, referencing the quality
  /// it measures.
  @icon("list-checks")
  scenario(refs<variadic>?: Ref(Any)): kind(in = [block], layer = Layer.SPECIFICATION, references = [rule, usecase, quality]) {
    stimulus?: Prose
    environment?: Prose
    response?: Prose
    measure?: Prose
    accept(prose)
    accept(kind = given)
    accept(kind = when, max = 1)
    accept(kind = then)
  }

  /// A state a scenario starts from.
  given: kind {
    accept(prose)
  }

  /// A use case's goal level.
  UseCaseLevel: enum {
    SUMMARY: Self
    USER: Self
    SUBFUNCTION: Self
  }

  /// How its primary actor reaches one goal with the product: its body is
  /// the main path as a numbered list and its extensions as items numbered
  /// `2a.`. Its references after the actor name the goals and qualities it
  /// serves and the assumptions it relies on.
  @icon("route")
  usecase(actor: Ref(actor), refs<variadic>?: Ref(Any), level?: UseCaseLevel, success?: String, minimal?: String): kind(in = [block, types.realized], layer = Layer.SPECIFICATION, references = [goal, quality, assumption]) {
    accept(prose)
  }

  // --- Lifecycles ---

  /// The lifecycle of an enum field.
  @icon("workflow")
  states(field: Ref(Any)): kind(in = [block, types.realized], layer = Layer.SPECIFICATION) {
    initial?: Any
    terminal?: List(Any)
    accept(prose)
    accept(kind = transition)
  }

  /// One allowed change of a lifecycle.
  @icon("arrow-right-left")
  transition(from: Any, to: Any): kind(in = [types.realized], layer = Layer.SPECIFICATION) {
    accept(prose)
    accept(kind = where, max = 1)
    accept(kind = while)
    accept(kind = when, max = 1)
    accept(kind = spec.if, max = 1)
    accept(kind = then, max = 1)
    accept(kind = instead, max = 1)
    accept(category = condition)
  }

  // --- Annotations ---

  /// Kinds of other packages that `@rev` stands on, as std/project's proof.
  revised: category

  /// Hard references written as an annotation, beside or instead of the
  /// constructor's: on any node, they mean what the constructor's would,
  /// and coverage and gaps count them. A kind with no `references` of its
  /// own takes the kinds in `types.realized`, as a type does. A reference
  /// is never in both the constructor and `@touch`.
  touch(targets<variadic>: Ref(Any)): annotation

  /// Soft references, for documentation: the nodes a node is about that
  /// its prose can't link. Rare; coverage and gaps don't count them, and
  /// the docs show them as "See also".
  see(targets<variadic>: Ref(Any)): annotation

  /// The revision of a requirement or contract entry, a whole number from
  /// 1, raised when its meaning changes; on a proof, the revision it proves.
  rev(n: Int): annotation(on = [rule, constraint, scenario, usecase, error, command, screen, revised])

  // --- Contract ---

  /// How serious a diagnostic is, as an editor shows it.
  Severity: enum {
    error: Self
    warning: Self
    info: Self
    hint: Self
  }

  /// One problem the product reports, with one identity on every surface:
  /// its id and its `title` with a `{name}` for each field. Its projections
  /// are annotations, one per surface: `@status` on an API, `@exit` on a
  /// command line, `@severity` as a diagnostic (an error when left out).
  /// Its prose links the rule, or `Fails.` extension, that says when it's
  /// reported. An error never names who reports it: the raiser names it, as
  /// an op's `@throws` or a command holding it, or the linked rule's
  /// subject does.
  @icon("circle-alert")
  error(id: String): kind(in = [block], layer = Layer.CONTRACT) {
    /// The message, with `{name}` for each field filled in where it happens.
    title: String
    /// The message reported at the related site.
    related?: String
    accept(prose)
    accept(kind = field)
    accept(kind = example)
  }

  /// The HTTP status code an error is returned with, its projection on an
  /// API: on a spec error, or on a type that implements Error.
  status(code: Int): annotation(on = [error, types.type])

  /// The exit code an error ends a command-line run with.
  exit(code: Int): annotation(on = [error])

  /// How serious an error is as a diagnostic; an error when left out.
  severity(level: Severity): annotation(on = [error])

  /// A value an error carries, as data and in its message.
  field(type: Any): kind(layer = Layer.CONTRACT) {
    accept(prose)
  }

  /// A concrete case with exact inputs and outputs; its reference names the
  /// outcome scenario it pins down. As a rule's child, a key or boundary
  /// case of the rule.
  example(refs<variadic>?: Ref(Any)): kind(in = [block], layer = Layer.CONTRACT, references = [scenario]) {
    accept(prose)
  }

  /// A command of a command-line tool, an entry of its surface: usage
  /// lines, arguments and options as its inputs, the errors it exits with,
  /// examples and subcommands. Its references after its name are the
  /// rules and use case steps it carries out.
  @icon("terminal")
  command(name: String, refs<variadic>?: Ref(Any)): kind(in = [block], layer = Layer.CONTRACT, references = [types.realized]) {
    /// One line per form, as `heron check [--json] [path…]`.
    usage?: List(String)
    /// The errors it reports, each with its `@exit`.
    errors?: List(Ref(error))
    accept(prose)
    accept(kind = argument)
    accept(kind = option)
    accept(kind = example)
    accept(kind = command)
    accept(kind = error)
    accept(category = block)
  }

  /// A positional argument of a command; its references after its name
  /// are the rules it carries out.
  argument(name: String, refs<variadic>?: Ref(Any), type?: Any, optional?: Bool, variadic?: Bool): kind(layer = Layer.CONTRACT, references = [types.realized]) {
    accept(prose)
  }

  /// A named option of a command, as `--json` or `-o`; its references
  /// after its name are the rules it carries out.
  option(name: String, refs<variadic>?: Ref(Any), type?: Any, default?: Any, short?: String, env?: String): kind(layer = Layer.CONTRACT, references = [types.realized]) {
    accept(prose)
  }

  /// A view of an app or a site and its regions. `route` is where it's
  /// served; its references after the route are the rules and use case
  /// steps it carries out.
  screen(route?: String, refs<variadic>?: Ref(Any)): kind(in = [block], layer = Layer.CONTRACT, references = [types.realized]) {
    accept(prose)
    accept(kind = region)
    accept(category = block)
  }

  /// One region of a screen and what it holds, nested as the layout nests;
  /// its references are the rules it carries out.
  region(refs<variadic>?: Ref(Any)): kind(in = [block], layer = Layer.CONTRACT, references = [types.realized]) {
    accept(prose)
    accept(kind = region)
    accept(category = block)
  }

  /// An entry of a surface that's no longer to be used.
  deprecated: flag(on = [command, screen, region, op, error])

  // --- Context for implementors ---

  /// Hints for implementors, such as internal APIs; never a requirement.
  guidance: kind(in = [block]) {
    accept(prose)
  }

  // --- Planning ---

  /// A question still to answer about what its prose links; `owner` names
  /// who answers it.
  open(owner?: String): kind(in = [block]) {
    accept(prose)
  }
}
