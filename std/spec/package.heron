// std/spec: the kinds a specification is written in, in its three layers:
// the intent (why a product exists and for whom), the specification (what
// must hold of it from outside, feature by feature, in its terms) and the
// contract (the exact surface a consumer relies on), with the references
// between them, projects, lifecycles and planning. It's part of the core: every tree sees it without an
// import, as it sees std/core, apart from the packages it's written with.
// The kinds of other packages join its annotations' open sets through the
// categories below, so it never names a package that isn't core.
import = ["std/schema@1", "std/types@1", "std/doc@1"]

spec: package(version = "1.1", requires = ["std/doc@1", "std/types@1"]) {
  // --- Projects ---

  /// One unit of the system, such as a service, a library or an app.
  project(path: String): kind {
    /// The spec subtrees the project implements.
    implements?: List(Ref(Any))
    /// Narrows a subtree to part of the project, by file pattern.
    paths?: Map(String, String)
    depends_on?: List(Ref(project))
    /// Who answers for the project; reviews route by it.
    owners?: List(String)
    /// The projects this one groups.
    members?: List(Ref(project))
    /// Where an external project's code comes from.
    source?: Source
    versioning?: Versioning
    releases?: Releases
    accept(kind = task)
  }

  /// Code the system uses but doesn't own, pinned with a source.
  external: flag(on = [project])

  /// Puts every member of a group on the group's one version.
  shared: flag

  /// A checked-out source: the url, the ref as written and the commit it
  /// resolved to.
  Source: type {
    url: String
    ref?: String
    commit?: String
  }

  /// Returns a source for a git repository at a ref.
  git(url: String, ref?: String): func(Source)

  /// How a project's versions are formed.
  Versioning: type {
    scheme?: String
    bumps?: Bumps
  }

  /// What raises a version.
  Bumps: interface

  /// Versions that follow the spec: what each kind of spec change bumps.
  FromSpec: type(Bumps) {
    breaking?: String
    added?: String
    clarified?: String
  }

  /// Where a project's releases are recorded.
  Releases: type {
    changelog?: String
  }

  // --- Intent ---

  /// Why a requirement exists: the goals and qualities it serves. A
  /// feature, a rule, a use case and a story reference it.
  motivation: category

  /// What a product is for, in the words of the people it's for, with an
  /// optional measure of success; its references name the actors or
  /// personas who asked for it. Validated, never proven by a test.
  @icon("target")
  goal(refs<variadic>?: Ref(Any), measure?: String): kind(in = [block, motivation], layer = Layer.INTENT, references = [actor, persona]) {
    accept(prose)
  }

  /// A role that crosses the system's boundary; its role flag says what
  /// kind of party it is, a person without one.
  @icon("user")
  actor: kind(in = [block], layer = Layer.INTENT) {
    accept(prose)
  }

  /// The role an actor plays: a person using the system, another program,
  /// called by or calling the system, or an AI agent acting for a person.
  person: flag(on = [actor], group = "role")
  system: flag(on = [actor], group = "role")
  agent: flag(on = [actor], group = "role")

  /// An archetype of a person; its references name the actors it plays.
  persona(refs<variadic>?: Ref(Any)): kind(in = [block], layer = Layer.INTENT, references = [actor]) {
    /// What the persona wants to get done.
    goals?: Prose
    /// What gets in their way today.
    pains?: Prose
    accept(prose)
  }

  /// Something the product could plausibly do and deliberately doesn't.
  nongoal: kind(in = [block], layer = Layer.INTENT) {
    accept(prose)
  }

  /// What the spec relies on an actor or the environment to do.
  assumption: kind(in = [block], layer = Layer.INTENT) {
    accept(prose)
  }

  /// One of the few qualities that matter most; its quality scenarios
  /// measure it.
  quality(measure?: String): kind(in = [block, motivation], layer = Layer.INTENT) {
    accept(prose)
  }

  // --- Specification ---

  /// Kinds of other packages that a contract surface's hard references may
  /// name, as this package's rule, use case, part, lifecycle
  /// and transition. A kind with no `references` of its own takes them with
  /// `@touch`, as a type does.
  touchable: category

  /// A capability of the product, as its users see it: the goals and
  /// qualities it serves, the actors it's for and the assumptions it
  /// relies on as its references, its intent in prose, then what it leaves
  /// out and its rules, use cases, scenarios, lifecycles, terms and
  /// guidance. Features nest. An
  /// `optional` feature is one a product may leave out; a rule's `where`
  /// links one.
  @icon("puzzle")
  feature(refs<variadic>?: Ref(Any), optional?: Bool): kind(in = [block], layer = Layer.SPECIFICATION, references = [motivation, actor, assumption]) {
    accept(prose)
    accept(category = block)
  }

  /// A feature that cuts across others, flagged so reviews and deciders
  /// find it and load it on its own.
  security: flag(on = [feature])
  privacy: flag(on = [feature])
  operations: flag(on = [feature])

  /// A word of the domain the glossary defines once.
  @icon("book-a")
  term(aliases?: List(String), context?: String): kind(in = [block], layer = Layer.SPECIFICATION) {
    accept(prose)
  }

  /// One behaviour in one strength node, and when it applies. A leaf: its
  /// references name what it states a fact about, at most one actor or
  /// part whose behaviour it states (without one, the system), the goals
  /// and qualities it serves, the assumptions it relies on and the
  /// features it belongs to beyond the one it stands in. It never
  /// references another rule; the terms it uses are linked in its prose.
  @icon("scale")
  rule(refs<variadic>?: Ref(Any)): kind(in = [block, touchable], layer = Layer.SPECIFICATION, references = [motivation, actor, part, assumption, feature]) {
    accept(prose)
    accept(category = strength, max = 1)
    accept(kind = where, max = 1)
    accept(kind = while)
    accept(kind = when, max = 1)
    accept(kind = spec.if, max = 1)
    accept(kind = then, max = 1)
    accept(kind = instead, max = 1)
    accept(category = condition)
    accept(kind = rationale, max = 1)
    accept(kind = example)
  }

  /// A party inside the boundary that rules bind, named by its role as
  /// seen from outside. No architecture.
  part: kind(in = [block, touchable], layer = Layer.SPECIFICATION) {
    accept(prose)
    accept(category = block)
  }

  /// The strengths a requirement states its behaviour with.
  strength: category

  /// The nodes that say when a requirement applies and what follows.
  condition: category

  must: kind(in = [strength]) {
    accept(prose)
  }

  should: kind(in = [strength]) {
    accept(prose)
  }

  may: kind(in = [strength]) {
    accept(prose)
  }

  must_not: kind(in = [strength]) {
    accept(prose)
  }

  should_not: kind(in = [strength]) {
    accept(prose)
  }

  /// A trigger.
  when: kind(in = [condition]) {
    accept(prose)
  }

  /// A state.
  while: kind(in = [condition]) {
    accept(prose)
  }

  /// The optional feature the requirement applies with, linked in its
  /// prose.
  where: kind(in = [condition]) {
    accept(prose)
  }

  /// An unwanted situation.
  if: kind(in = [condition]) {
    accept(prose)
  }

  /// A consequence the system guarantees once the rule applies.
  then: kind(in = [condition]) {
    accept(prose)
  }

  /// Under a negative strength, the intended alternative.
  instead: kind(in = [condition]) {
    accept(prose)
  }

  /// Why a rule holds, in a line.
  rationale: kind {
    accept(prose)
  }

  /// An outcome scenario, one case of the one rule or path of a use case it
  /// references, in given, when and then; or a quality scenario, with
  /// stimulus, environment, response and measure, referencing the quality
  /// it measures.
  @icon("list-checks")
  scenario(refs<variadic>?: Ref(Any)): kind(in = [block], layer = Layer.SPECIFICATION, references = [rule, usecase, quality]) {
    stimulus?: Prose
    environment?: Prose
    response?: Prose
    measure?: Prose
    accept(prose)
    accept(kind = given)
    accept(kind = when, max = 1)
    accept(kind = then)
  }

  /// A state a scenario starts from.
  given: kind {
    accept(prose)
  }

  /// How its primary actor reaches one goal with the product: its body is
  /// the main path as a numbered list and its extensions as items numbered
  /// `2a.`, with its `success` and `minimal` guarantees. Its references
  /// name its actors, the first its primary actor and any later one a
  /// secondary actor, the goals and qualities it serves and the
  /// assumptions it relies on; it references at least one actor.
  @icon("route")
  usecase(refs<variadic>?: Ref(Any)): kind(in = [block, touchable], layer = Layer.SPECIFICATION, references = [motivation, actor, assumption]) {
    accept(prose)
    accept(kind = success, max = 1)
    accept(kind = minimal, max = 1)
  }

  /// A use case's goal level: a summary of several user goals, one user
  /// goal, or a subfunction of one.
  summary: flag(on = [usecase], group = "level")
  user: flag(on = [usecase], group = "level")
  subfunction: flag(on = [usecase], group = "level")

  /// What a use case guarantees once it succeeds.
  success: kind {
    accept(prose)
  }

  /// What a use case guarantees whichever way it ends.
  minimal: kind {
    accept(prose)
  }

  // --- Lifecycles ---

  /// The lifecycle of an enum field.
  @icon("workflow")
  states(field: Ref(Any)): kind(in = [block, touchable], layer = Layer.SPECIFICATION) {
    initial?: Any
    terminal?: List(Any)
    accept(prose)
    accept(kind = transition)
  }

  /// One allowed change of a lifecycle.
  @icon("arrow-right-left")
  transition(from: Any, to: Any): kind(in = [touchable], layer = Layer.SPECIFICATION) {
    accept(prose)
    accept(kind = where, max = 1)
    accept(kind = while)
    accept(kind = when, max = 1)
    accept(kind = spec.if, max = 1)
    accept(kind = then, max = 1)
    accept(kind = instead, max = 1)
    accept(category = condition)
  }

  // --- Annotations ---

  /// Kinds of other packages that `@rev` stands on, as std/project's proof.
  revised: category

  /// Hard references written as an annotation, beside or instead of the
  /// constructor's: on any node, they mean what the constructor's would,
  /// and coverage and gaps count them. A kind with no `references` of its
  /// own takes the kinds in `touchable`, as a type does. A reference
  /// is never in both the constructor and `@touch`.
  touch(targets<variadic>: Ref(Any)): annotation

  /// Soft references, for documentation: the nodes a node is about that
  /// its prose can't link. Rare; coverage and gaps don't count them, and
  /// the docs show them as "See also".
  see(targets<variadic>: Ref(Any)): annotation

  /// The revision of a requirement or contract entry, a whole number from
  /// 1, raised when its meaning changes; on a proof, the revision it proves.
  rev(n: Int): annotation(on = [rule, scenario, usecase, types.error, command, screen, revised])

  // --- Contract ---

  /// The exit status an error ends a command-line run with, where the one
  /// derived from its status doesn't fit.
  exit(code: Int): annotation(on = [types.error])

  /// A concrete case with exact inputs and outputs; its reference names the
  /// outcome scenario it pins down. As a rule's child, a key or boundary
  /// case of the rule; inside an op, it sets the op's parameters as fields
  /// and states the outcome as `returns` or `throws`, or is only text, as
  /// in `example {{ … }}`.
  example(refs<variadic>?: Ref(Any)): kind(in = [block], layer = Layer.CONTRACT, references = [scenario], fields_from = types.op) {
    accept(prose)
    accept(binding = returns, max = 1)
    accept(binding = throws, max = 1)
  }

  /// A command of a command-line tool, an entry of its surface, declared
  /// as an op is: its parameters are its inputs, each a positional
  /// argument unless `@option` makes it an option, optional with `?` or a
  /// default and repeated with `<variadic>`. Its body holds the errors it
  /// exits with, which `@throws` may name instead, its examples and its
  /// subcommands. Its references after its name are the rules and use
  /// case steps it carries out.
  @icon("terminal")
  command(name: String, refs<variadic>?: Ref(Any)): kind(in = [block], layer = Layer.CONTRACT, references = [touchable]) {
    accept(prose)
    accept(kind = example)
    accept(kind = command)
    accept(kind = types.error)
    accept(category = block)
  }

  /// Makes a command's parameter an option, as `--dry-run` for `dry_run`:
  /// `short` is its one-letter form, as `-n`, `env` the environment
  /// variable it's read from when it isn't given, and `value` the word its
  /// usage shows for its value, as `file`.
  option(short?: String, env?: String, value?: String): annotation(on = [types.param])

  /// A view of an app or a site and its regions. `route` is where it's
  /// served; its references after the route are the rules and use case
  /// steps it carries out.
  screen(route?: String, refs<variadic>?: Ref(Any)): kind(in = [block], layer = Layer.CONTRACT, references = [touchable]) {
    accept(prose)
    accept(kind = region)
    accept(category = block)
  }

  /// One region of a screen and what it holds, nested as the layout nests;
  /// its references are the rules it carries out.
  region(refs<variadic>?: Ref(Any)): kind(in = [block], layer = Layer.CONTRACT, references = [touchable]) {
    accept(prose)
    accept(kind = region)
    accept(category = block)
  }

  /// An entry of a surface that's no longer to be used.
  deprecated: flag(on = [command, screen, region, types.op, types.error])

  // --- Context for implementors ---

  /// Hints for implementors, such as internal APIs; never a requirement.
  guidance: kind(in = [block]) {
    accept(prose)
  }

  // --- Planning ---

  /// A question still to answer about what its prose links; `owner` names
  /// who answers it.
  open(owner?: String): kind(in = [block]) {
    accept(prose)
  }
}
