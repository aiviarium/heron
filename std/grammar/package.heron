// std/grammar: a language's grammar as a surface of the contract layer: its
// productions and tokens, in a notation whose operators are `|`, `?`, `*`,
// `+` and grouping. A spec that describes a language imports it.
import = ["std/schema@1", "std/types@1", "std/doc@1"]

grammar: package(version = "1.0", requires = ["std/doc@1"]) {
  /// A language's grammar: its productions and tokens; `source` names the
  /// file, a path, the grammar is kept equal to.
  grammar(refs<variadic>?: Ref(Any), notation?: String, source?: String): kind(in = [block], layer = Layer.CONTRACT, references = [types.realized]) {
    /// The production a whole input is read as.
    start?: Ref(production)
    accept(prose)
    accept(kind = production)
    accept(kind = token)
    accept(category = block)
  }

  /// A nonterminal and its expression: names of other productions and
  /// tokens, quoted literals and the operators. Its `///` docs say what it
  /// reads.
  production(refs<variadic>?: Ref(Any)): kind(in = [block], layer = Layer.CONTRACT, references = [types.realized]) {
    accept(text = Verbatim)
  }

  /// A terminal, by its pattern or literal.
  token(refs<variadic>?: Ref(Any)): kind(in = [block], layer = Layer.CONTRACT, references = [types.realized]) {
    accept(text = Verbatim)
  }
}
