// std/js: foreign functions and extension points implemented in JS or TS,
// from the Interop tab.
import = ["std/schema@1", "std/types@1"]

js: package(version = "1.0", requires = ["std/types@1"]) {
  /// An implementation module: a file in the repository or an npm package.
  module: kind

  /// Names a JS or TS module, such as js("./tools/orders.ts").
  js(path: String): func(Any)

  /// Writes TS types for every type, kind and binding the project uses,
  /// with the `bind` helpers implementations are checked against, into
  /// `.heron/`. Built into the binary and registered like any adapter.
  ts: generator(target = "ts")
}
