// std/docs: how the docs generator is configured, from the Development
// tools tab's "Styling and extending the docs": the theme, the layout each
// section uses and the components each slot shows. A tree enters it once,
// as `docs { … }`.
import = ["std/schema@1", "std/types@1", "std/doc@1", "std/grammar@1"]

docs: package(version = "1.0", requires = ["std/doc@1"]) {
  /// The docs generator's configuration.
  site: kind {
    /// The theme package: `npm:<name>@<major>`, found in node_modules, or
    /// a folder such as "./theme". Its tokens, fonts, logo and CSS go in a
    /// `theme` layer after the built-in theme.
    theme?: String
    /// How many levels of sections get pages of their own; 2 unless set.
    /// Components, commands, use cases and screens get pages at any
    /// depth.
    depth?: Int
    accept(kind = layout)
    accept(kind = slot)
    accept(kind = lens)
    accept(kind = area)
    /// The lenses the site builds, in the order the lens switcher lists
    /// them: the default one at the site's root and the others under their
    /// prefix. Unset, the site builds `explore` alone, at its root.
    lenses?: List(Ref(lens))
  }

  /// The docs of the tree, entered as `docs { … }`.
  docs<export>: site

  /// The layout the pages of some sections use: "docs", "api",
  /// "changelog" or "landing".
  layout(name: String): kind {
    /// The sections, apis or scopes whose pages, and the pages below them,
    /// take the layout.
    sections: List(Ref(Any))
  }

  /// Components a place on every page shows: the page "header", the
  /// "sidebar", or "before" and "after" the content. With `of`, "before"
  /// and "after" are in that kind's renderer, around each node of it.
  slot(name: String, of?: Ref(Any)): kind {
    accept(prose)
    accept(category = block)
  }

  /// A top-level node of the tree that gets a site area of its own, with
  /// its own navigation; its title and icon come from the node's @display
  /// and @icon.
  area(node: Ref(Any)): kind

  /// Where an area is offered: as a tab in the top bar (the default), or
  /// in the area switcher at the top of the sidebar, which lists the
  /// switcher's areas with their icon and the first sentence of their
  /// prose.
  tab: flag(on = [area], group = "placement")
  menu: flag(on = [area], group = "placement")

  /// What a lens is written as.
  LensFormat: enum {
    /// Pages of the site.
    HTML: Self
    /// Plain Markdown files for agents: the agent export.
    MARKDOWN: Self
  }

  /// Whether a lens marks a node's kind.
  KindMarks: enum {
    /// With the kind's icon, labelled with the kind's name: before a
    /// node's name and in the gutter beside the nodes a page defines.
    ICON: Self
    /// Not at all.
    NONE: Self
  }

  /// A view of the site for one audience, built from the same tree as
  /// every other: which kinds and categories it shows, which it sums up in
  /// one line and which it leaves out, which pages it puts first and
  /// where it's served. `@lens(…)` keeps a node or a prose block to some
  /// lenses; explore shows everything.
  lens: kind {
    /// The lens's name in the switcher.
    title: String
    /// The lens served at the site's root; one per site.
    default?: Bool
    /// Kinds or categories rendered in full.
    show?: List(Ref(Any))
    /// Kinds rendered as one line, expandable.
    summarize?: List(Ref(Any))
    /// Kinds left out.
    hide?: List(Ref(Any))
    /// Authored pages shown first.
    entry?: List(Ref(Any))
    /// How many levels of sections get pages of their own in the lens, in
    /// place of the docs block's `depth`.
    depth?: Int
    /// The URL path segment the lens is served under; "" for the default.
    prefix: String
    /// What the lens is written as; HTML unless set.
    format?: LensFormat
    /// Whether `@lens(…)` marks naming other lenses leave nodes out of
    /// this one; true unless set.
    marks?: Bool
    /// The size budget, in approximate tokens, of a file a Markdown lens
    /// writes; 6000 unless set.
    budget?: Int
    /// Whether the lens marks a node's kind with its icon; ICON unless set.
    kinds?: KindMarks
  }

  /// For the developers who use what a tree describes: the full
  /// reference, each rule summed up in one line that opens in place, and
  /// none of what's only about building the product, its actors and its
  /// parts.
  user: lens {
    title = "User"
    default = true
    summarize = [spec.rule]
    hide = [spec.actor, spec.part]
    prefix = ""
  }

  /// For the people who work on the product itself: everything in full,
  /// with its actors, its parts, its gaps and its contract coverage.
  contributor: lens {
    title = "Contributor"
    prefix = "contributor"
  }

  /// Everything the tree holds, as the node tree.
  explore: lens {
    title = "Explore"
    prefix = "explore"
  }

  /// For agents that build, change or review what the tree specifies:
  /// every node but the authored pages, whatever the lens marks say, as
  /// the plain Markdown files of the agent export.
  agent: lens {
    title = "Agents"
    format = LensFormat.MARKDOWN
    marks = false
    hide = [authored]
    budget = 6000
    prefix = "agents"
  }

  /// Pages written for a lens's readers rather than derived from the
  /// tree's structure. Each gets a page of its own; its examples are
  /// checked as the spec's are, its links resolve, and `${path.field}`
  /// shows the value of a spec node, failing the check once it's gone.
  authored: category

  /// A page that explains how to get something done with the system,
  /// start to finish, in prose.
  @icon("compass")
  guide: kind(in = [authored, doc.block], heading = true) {
    accept(prose)
    accept(category = doc.block)
    accept(kind = spec.example)
  }

  /// A page that walks through one task in numbered steps.
  @icon("signpost")
  howto: kind(in = [authored, doc.block], heading = true) {
    accept(prose)
    accept(kind = step)
    accept(category = doc.block)
    accept(kind = spec.example)
  }

  /// One step of a how-to or a tutorial, numbered in the order written.
  step: kind(heading = true) {
    accept(prose)
    accept(category = doc.block)
    accept(kind = spec.example)
  }

  /// A page that explains an idea the reader needs before the reference
  /// makes sense.
  @icon("lightbulb")
  concept: kind(in = [authored, doc.block], heading = true) {
    accept(prose)
    accept(category = doc.block)
    accept(kind = spec.example)
  }

  /// A page that teaches by building something, in numbered steps.
  @icon("graduation-cap")
  tutorial: kind(in = [authored, doc.block], heading = true) {
    accept(prose)
    accept(kind = step)
    accept(category = doc.block)
    accept(kind = spec.example)
  }

  /// An icon a node can show in the docs, by `@icon("name")`: a
  /// monochrome SVG drawn in `currentColor`, read from `file`, relative to
  /// the file that declares it. Its name is the node's name with each `_`
  /// read as `-`. A package declares icons of its own beside these; a
  /// tree's icon of the same name shadows an imported one.
  svg_icon: kind {
    file: String
  }

  /// A set of icons, so a package's icons stand apart from its other names.
  icon_set: kind {
    accept(kind = svg_icon)
  }

  /// The icons std/docs offers, from Lucide (ISC license, icons/LICENSE).
  lucide: icon_set {
    arrow_right_left: svg_icon { file = "./icons/arrow-right-left.svg" }
    bell: svg_icon { file = "./icons/bell.svg" }
    blocks: svg_icon { file = "./icons/blocks.svg" }
    book_a: svg_icon { file = "./icons/book-a.svg" }
    book_open: svg_icon { file = "./icons/book-open.svg" }
    box: svg_icon { file = "./icons/box.svg" }
    braces: svg_icon { file = "./icons/braces.svg" }
    check: svg_icon { file = "./icons/check.svg" }
    circle_alert: svg_icon { file = "./icons/circle-alert.svg" }
    circle_check: svg_icon { file = "./icons/circle-check.svg" }
    circle_dashed: svg_icon { file = "./icons/circle-dashed.svg" }
    circle_help: svg_icon { file = "./icons/circle-help.svg" }
    circle_x: svg_icon { file = "./icons/circle-x.svg" }
    code: svg_icon { file = "./icons/code.svg" }
    compass: svg_icon { file = "./icons/compass.svg" }
    database: svg_icon { file = "./icons/database.svg" }
    eye: svg_icon { file = "./icons/eye.svg" }
    file_code: svg_icon { file = "./icons/file-code.svg" }
    file_text: svg_icon { file = "./icons/file-text.svg" }
    files: svg_icon { file = "./icons/files.svg" }
    flag: svg_icon { file = "./icons/flag.svg" }
    folder_tree: svg_icon { file = "./icons/folder-tree.svg" }
    git_branch: svg_icon { file = "./icons/git-branch.svg" }
    globe: svg_icon { file = "./icons/globe.svg" }
    graduation_cap: svg_icon { file = "./icons/graduation-cap.svg" }
    hash: svg_icon { file = "./icons/hash.svg" }
    history: svg_icon { file = "./icons/history.svg" }
    info: svg_icon { file = "./icons/info.svg" }
    key_round: svg_icon { file = "./icons/key-round.svg" }
    languages: svg_icon { file = "./icons/languages.svg" }
    layers: svg_icon { file = "./icons/layers.svg" }
    layout_grid: svg_icon { file = "./icons/layout-grid.svg" }
    library: svg_icon { file = "./icons/library.svg" }
    lightbulb: svg_icon { file = "./icons/lightbulb.svg" }
    list: svg_icon { file = "./icons/list.svg" }
    list_checks: svg_icon { file = "./icons/list-checks.svg" }
    lock: svg_icon { file = "./icons/lock.svg" }
    map: svg_icon { file = "./icons/map.svg" }
    message_square: svg_icon { file = "./icons/message-square.svg" }
    milestone: svg_icon { file = "./icons/milestone.svg" }
    network: svg_icon { file = "./icons/network.svg" }
    notebook_pen: svg_icon { file = "./icons/notebook-pen.svg" }
    octagon_alert: svg_icon { file = "./icons/octagon-alert.svg" }
    package: svg_icon { file = "./icons/package.svg" }
    palette: svg_icon { file = "./icons/palette.svg" }
    plug: svg_icon { file = "./icons/plug.svg" }
    puzzle: svg_icon { file = "./icons/puzzle.svg" }
    radio: svg_icon { file = "./icons/radio.svg" }
    route: svg_icon { file = "./icons/route.svg" }
    scale: svg_icon { file = "./icons/scale.svg" }
    search: svg_icon { file = "./icons/search.svg" }
    server: svg_icon { file = "./icons/server.svg" }
    settings: svg_icon { file = "./icons/settings.svg" }
    shield: svg_icon { file = "./icons/shield.svg" }
    signpost: svg_icon { file = "./icons/signpost.svg" }
    square_function: svg_icon { file = "./icons/square-function.svg" }
    tag: svg_icon { file = "./icons/tag.svg" }
    target: svg_icon { file = "./icons/target.svg" }
    terminal: svg_icon { file = "./icons/terminal.svg" }
    triangle_alert: svg_icon { file = "./icons/triangle-alert.svg" }
    type: svg_icon { file = "./icons/type.svg" }
    user: svg_icon { file = "./icons/user.svg" }
    users: svg_icon { file = "./icons/users.svg" }
    variable: svg_icon { file = "./icons/variable.svg" }
    workflow: svg_icon { file = "./icons/workflow.svg" }
    wrench: svg_icon { file = "./icons/wrench.svg" }
    zap: svg_icon { file = "./icons/zap.svg" }
  }
}
