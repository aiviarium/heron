// std/docs: how the docs generator is configured, from the Development
// tools tab's "Styling and extending the docs": the theme, the layout each
// section uses, the components each slot shows and the modules that render
// kinds. A tree enters it once, as `docs { … }`.
import = ["std/schema@1", "std/types@1", "std/js@1", "std/doc@1", "std/spec@1", "std/grammar@1"]

docs: package(version = "1.0", requires = ["std/doc@1"]) {
  /// The docs generator's configuration.
  site: kind {
    /// The theme package: `npm:<name>@<major>`, found in node_modules, or
    /// a folder such as "./theme". Its tokens, fonts, logo and CSS go in a
    /// `theme` layer after the built-in theme.
    theme?: String
    /// Modules whose renderers register per kind, such as
    /// `js("./docs/renderers.ts")`. They run through the JS host when the
    /// docs are generated; a kind none of them renders keeps its built-in
    /// renderer, or the generic view of its fields and children.
    renderers?: List(module)
    /// How many levels of sections get pages of their own; 2 unless set.
    /// Components, commands, use cases and screens get pages at any
    /// depth.
    depth?: Int
    accept(kind = layout)
    accept(kind = slot)
    accept(kind = lens)
    /// The lenses the site builds, in the order the lens switcher lists
    /// them: the default one at the site's root and the others under their
    /// prefix. Unset, the site builds `explore` alone, at its root.
    lenses?: List(Ref(lens))
  }

  /// The docs of the tree, entered as `docs { … }`.
  docs<export>: site

  /// The layout the pages of some sections use: "docs", "api",
  /// "changelog" or "landing".
  layout(name: String): kind {
    /// The sections, apis or scopes whose pages, and the pages below them,
    /// take the layout.
    sections: List(Ref(Any))
  }

  /// Components a place on every page shows: the page "header", the
  /// "sidebar", or "before" and "after" the content. With `of`, "before"
  /// and "after" are in that kind's renderer, around each node of it.
  slot(name: String, of?: Ref(Any)): kind {
    accept(prose)
    accept(category = block)
  }

  /// How a lens orders its navigation.
  LensNav: enum {
    /// The authored pages first, then the reference.
    TASK: Self
    /// The sections, by topic.
    TOPIC: Self
    /// The node tree, as written.
    TREE: Self
  }

  /// A view of the site for one audience, built from the same tree as
  /// every other: which kinds and categories it shows, which it sums up in
  /// one line and which it leaves out, how its navigation is ordered and
  /// where it's served. `@lens(…)` keeps a node or a prose block to some
  /// lenses; explore shows everything.
  lens: kind {
    /// The lens's name in the switcher.
    title: String
    /// The lens served at the site's root; one per site.
    default?: Bool
    /// Kinds or categories rendered in full.
    show?: List(Ref(Any))
    /// Kinds rendered as one line, expandable.
    summarize?: List(Ref(Any))
    /// Kinds left out.
    hide?: List(Ref(Any))
    nav: LensNav
    /// Authored pages shown first.
    entry?: List(Ref(Any))
    /// How many levels of sections get pages of their own in the lens, in
    /// place of the docs block's `depth`.
    depth?: Int
    /// The URL path segment the lens is served under; "" for the default.
    prefix: String
  }

  /// For the people who use what a tree describes: the authored pages
  /// first, then the commands, examples, terms and errors they act on,
  /// without the rules that bind an implementation or the tree's sections,
  /// with a page per part of the tree rather than per concern.
  user: lens {
    title = "User"
    default = true
    nav = LensNav.TASK
    show = [authored, step, spec.goal, spec.nongoal, spec.example, doc.term, spec.command, spec.argument, spec.option, spec.error]
    hide = [spec.rule, spec.condition, production]
    depth = 2
    prefix = ""
  }

  /// For the people who write specs of their own: sections by topic, the
  /// examples, APIs and diagrams up front, and each rule summed up in one
  /// line.
  developer: lens {
    title = "Developer"
    nav = LensNav.TOPIC
    summarize = [spec.rule, spec.constraint, spec.guidance]
    prefix = "dev"
  }

  /// Everything the tree holds, as the node tree.
  explore: lens {
    title = "Explore"
    nav = LensNav.TREE
    prefix = "explore"
  }

  /// Pages written for a lens's readers rather than derived from the
  /// tree's structure. Each gets a page of its own; its examples are
  /// checked as the spec's are, its links resolve, and `${path.field}`
  /// shows the value of a spec node, failing the check once it's gone.
  authored: category

  /// A page that explains how to get something done with the system,
  /// start to finish, in prose.
  guide: kind(in = [authored, doc.block], heading = true) {
    accept(prose)
    accept(category = doc.block)
    accept(kind = spec.example)
  }

  /// A page that walks through one task in numbered steps.
  howto: kind(in = [authored, doc.block], heading = true) {
    accept(prose)
    accept(kind = step)
    accept(category = doc.block)
    accept(kind = spec.example)
  }

  /// One step of a how-to or a tutorial, numbered in the order written.
  step: kind(heading = true) {
    accept(prose)
    accept(category = doc.block)
    accept(kind = spec.example)
  }

  /// A page that explains an idea the reader needs before the reference
  /// makes sense.
  concept: kind(in = [authored, doc.block], heading = true) {
    accept(prose)
    accept(category = doc.block)
    accept(kind = spec.example)
  }

  /// A page that teaches by building something, in numbered steps.
  tutorial: kind(in = [authored, doc.block], heading = true) {
    accept(prose)
    accept(kind = step)
    accept(category = doc.block)
    accept(kind = spec.example)
  }
}
