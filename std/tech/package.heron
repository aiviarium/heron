// std/tech: the technical shape of a system, for the people and agents who
// build it: components with their contracts, a tool's commands, and a
// language's grammar. Requirements on them are std/spec's rules, and
// `verify` links any of them to the test that proves it.
import = ["std/schema@1", "std/types@1", "std/doc@1", "std/spec@1"]

tech: package(version = "1.0", requires = ["std/doc@1", "std/spec@1"]) {
  // --- Components ---

  /// A unit of code with one contract, such as a Go or TS package, at a
  /// path from the repository root.
  component(path: String, lang?: String): kind(in = [block]) {
    /// The components it may import; any other import breaks the contract.
    uses?: List(Ref(component))
    accept(prose)
    accept(kind = responsibility)
    accept(kind = surface)
    accept(kind = invariant)
    accept(kind = raises)
    accept(kind = obligation)
    accept(kind = spec.verify)
    accept(category = block)
  }

  /// One thing a component owns. What no responsibility names belongs
  /// elsewhere.
  responsibility: kind {
    accept(prose)
  }

  /// Part of the exported interface of a component, as code in the
  /// component's language unless `lang` names another; `title` names the
  /// file or group it comes from.
  surface(lang?: String, title?: String): kind {
    accept(text = Verbatim)
  }

  /// A property that holds of a component at every call, as a rule does
  /// of a system.
  invariant: kind(in = [block]) {
    accept(prose)
    accept(category = strength, max = 1)
    accept(kind = spec.verify)
  }

  /// An error a component returns or reports, by its name or code.
  raises(name: String): kind {
    accept(prose)
  }

  /// A test a component's suite must hold, as a test or script path.
  obligation(path?: String): kind {
    accept(prose)
  }

  // --- Diagnostics ---

  /// How serious a diagnostic is, as an editor shows it.
  Severity: enum {
    error: Self
    warning: Self
    info: Self
    hint: Self
  }

  /// A diagnostic a tool reports, by its code: how serious it is, the
  /// message with a ‹name› for each part filled in at the site, the
  /// message at the related site when it has one, and `by` the component
  /// that reports it. One code may name several diagnostics, each a node
  /// of its own.
  diagnostic(code: String, severity: Severity = Severity.error, by?: Ref(Any)): kind(in = [block]) {
    /// The message reported at the site, with ‹name› for each filled part.
    message: String
    /// The message reported at the related site.
    related?: String
    accept(prose)
    accept(kind = spec.example)
    accept(kind = spec.verify)
  }

  // --- Commands ---

  /// A command of a command-line tool, such as `heron check`, with its
  /// usage lines, arguments, options, exit codes and examples. Commands
  /// nest for subcommands.
  command(name: String): kind(in = [block]) {
    /// One line per form, as `heron check [--json] [path…]`.
    usage?: List(String)
    accept(prose)
    accept(kind = argument)
    accept(kind = option)
    accept(kind = exit)
    accept(kind = spec.example)
    accept(kind = spec.verify)
    accept(kind = command)
    accept(category = block)
  }

  /// A positional argument of a command.
  argument(name: String, type?: Any, optional?: Bool, variadic?: Bool): kind {
    accept(prose)
  }

  /// A named option of a command, as `--json` or `-o`.
  option(name: String, type?: Any, default?: Any, short?: String, env?: String): kind {
    accept(prose)
  }

  /// An exit status of a command and when it's returned.
  exit(code: Int): kind {
    accept(prose)
  }

  // --- Grammars ---

  /// A language's grammar: its productions and tokens, in a notation
  /// whose operators are `|`, `?`, `*`, `+` and grouping. `source` is a
  /// file the grammar is kept equal to.
  grammar(notation?: String, source?: String): kind(in = [block]) {
    /// The production a whole input is read as.
    start?: Ref(production)
    accept(prose)
    accept(kind = production)
    accept(kind = token)
    accept(category = block)
  }

  /// A nonterminal and its expression: names of other productions and
  /// tokens, quoted literals and the operators. Its `///` docs say what it
  /// reads.
  production: kind(in = [block]) {
    accept(text = Verbatim)
  }

  /// A terminal, by its pattern or literal.
  token: kind(in = [block]) {
    accept(text = Verbatim)
  }

  // --- Screens ---

  /// A view of an app or a site and its regions, as the reference screens
  /// describe them. `route` is where it's served.
  screen(route?: String): kind(in = [block]) {
    accept(prose)
    accept(kind = region)
    accept(category = block)
  }

  /// One region of a screen and what it holds, nested as the layout nests.
  region: kind(in = [block]) {
    accept(prose)
    accept(kind = region)
    accept(category = block)
  }
}
