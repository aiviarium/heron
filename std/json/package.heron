// std/json: JSON encoding, from the Data and Scripting tabs.
import = ["std/schema@1", "std/types@1"]

json: package(version = "1.0", requires = ["std/types@1"]) {
  /// JSON text, as an embedded language.
  json: language(grammar = "source.json")

  /// Text that isn't JSON, or isn't the shape of the type asked for.
  DecodeError: error(400) {
    title = "{message}"
    message: String
  }

  /// A value JSON can't hold.
  EncodeError: error(400) {
    title = "{message}"
    message: String
  }

  /// How a type's field names are written in JSON.
  Case: enum {
    /// As the members are named.
    as_written: Self
    /// In lower camel case, as line_number is lineNumber.
    camel: Self
  }

  /// A member's or a parameter's name in JSON.
  key(name: String): annotation(on = [types.member, types.param])

  /// The case of a type's field names in JSON; on an api, of its ops'
  /// parameters and of every type they reach that sets none.
  keys(case: Case): annotation(on = [types.type, types.error, types.api])

  /// Reads JSON text as a value of a type.
  @throws(DecodeError)
  decode(type: Any, text: String): func(Any)

  /// Writes a value as JSON text.
  @throws(EncodeError)
  encode(value: Any): func(String)
}
