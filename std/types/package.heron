// std/types: records, enums, unions, interfaces, apis and the types the
// Data and APIs tabs build on.
import = ["std/schema@1", "std/spec@1", "std/doc@1"]

types: package(version = "1.0") {
  /// A record. Each member is `name<flags>?: Type = default`; its
  /// positional arguments are the interfaces it implements.
  @icon("braces")
  type(implements<variadic>?: Ref(interface)): kind(layer = Layer.CONTRACT) {
    accept(kind = member, infer = true)
    accept(kind = func)
  }

  /// A record that also accepts members it doesn't declare.
  open: flag(on = [type])

  /// A member of a type: the expression after `:` is its type.
  member: kind(typed = true)

  /// A parameter of an op, func or kind.
  param: kind(typed = true)

  /// A closed set of values; its params are the constructor for them.
  enum(implements<variadic>?: Ref(interface)): kind(layer = Layer.CONTRACT) {
    accept(kind = variant, infer = true)
  }

  /// A value of an enum, of the enum's own type, or a variant of a union.
  variant: kind(typed = true)

  /// A union of types, each value one of its variants. A variant is
  /// positional, as `union(Card, BankTransfer)`, its tag the type's name in
  /// snake_case, or in the body as `name: Type`, its tag the name; the two
  /// forms mix, and the tags are unique. Tagged unless `<untagged>`.
  union(variants<variadic>?: Any): kind(layer = Layer.CONTRACT) {
    accept(kind = variant, infer = true)
  }

  /// How a union's values are told apart on the wire: by the variant's tag,
  /// the default, or by their shape alone, as `String | Int` is.
  /// `union<untagged>(String, Int)` is `String | Int`, and its body names
  /// are labels only.
  tagged: flag(on = [union], group = "tagging")
  untagged: flag(on = [union], group = "tagging")

  /// Shared members and behaviour.
  interface(implements<variadic>?: Ref(interface)): kind(layer = Layer.CONTRACT) {
    accept(kind = member, infer = true)
    accept(kind = func)
  }

  /// A group of operations; its references name the rules, use cases and
  /// parts it carries out.
  @icon("server")
  api(refs<variadic>?: Ref(Any)): kind(layer = Layer.CONTRACT, references = [spec.touchable]) {
    accept(prose)
    accept(kind = op)
  }

  /// An operation: its inputs as parameters, its result type first, then
  /// its references: the rules, use case steps and transitions it carries
  /// out, told from the result type by kind. An op that references a
  /// transition performs it.
  @icon("zap")
  op(returns?: Any, refs<variadic>?: Ref(Any)): kind(layer = Layer.CONTRACT, references = [spec.touchable]) {
    accept(prose)
    accept(kind = spec.example)
  }

  /// One problem a product reports, a type of its own, usable wherever a
  /// type is, with one identity on every surface. `status` is its HTTP
  /// status, the projection the codes of the other surfaces derive from,
  /// and an override annotation, as `@exit`, sets one where the derived
  /// code doesn't fit; `id` names it on every surface, the node's name when
  /// left out, and `status_text` is shown beside the status, the id when
  /// left out. Its `title` is the message, with a `{name}` for each of its
  /// members, the values it carries as data, typed as a record's are. A
  /// severity flag says how serious it is as a diagnostic, an error without
  /// one. Its prose links the rule, or `Fails.` extension, that says when
  /// it's reported; it never names who reports it.
  @icon("circle-alert")
  error<overload>(status: Int, id?: String, status_text?: String): kind(in = [block], layer = Layer.CONTRACT) {
    /// The message, with `{name}` for each member filled in where it
    /// happens.
    title: String
    /// The message reported at the related site.
    related?: String
    accept(prose)
    accept(kind = member, infer = true)
    accept(kind = spec.example)
  }

  /// An error that extends another, its one parent: it's a case of the
  /// parent, so a `@throws` of the parent covers it, and it inherits the
  /// parent's status, override annotations, severity flag, title, related
  /// message and members. It may set any of them again and add members,
  /// but never removes or retypes one; its id and status text are its own.
  @icon("circle-alert")
  error<overload>(extends: Ref(error), status?: Int, id?: String, status_text?: String): kind(in = [block], layer = Layer.CONTRACT) {
    title?: String
    related?: String
    accept(prose)
    accept(kind = member, infer = true)
    accept(kind = spec.example)
  }

  /// How serious an error is as a diagnostic, as an editor shows it; an
  /// error without one of them.
  warning: flag(on = [error], group = "severity")
  info: flag(on = [error], group = "severity")
  hint: flag(on = [error], group = "severity")

  /// A moment in time.
  Timestamp: type

  /// A length of time. A string such as "30d" or "200ms" is parsed as one.
  Duration: type {
    days?: Int
    hours?: Int
    minutes?: Int
    seconds?: Int
    millis?: Int
  }

  /// An amount in a currency. A string such as "40.00 EUR" is parsed as one.
  Money: type {
    amount: Decimal
    currency: String
  }

  /// Every member of T made optional, for updates.
  Patch(T: Any): type

  /// Values streamed one after another.
  Stream(T: Any): type

  /// What `attempt(…)` returns: the value, or the error thrown.
  Result(T: Any, E: Any): type {
    value?: T
    error?: E
  }

  u8 = Int(bits = 8, signed = false)
  u16 = Int(bits = 16, signed = false)
  u32 = Int(bits = 32, signed = false)
  u64 = Int(bits = 64, signed = false)
  i8 = Int(bits = 8)
  i16 = Int(bits = 16)
  i32 = Int(bits = 32)
  i64 = Int(bits = 64)
  f32 = Float(bits = 32)
  f64 = Float(bits = 64)
}
