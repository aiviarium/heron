// std/sparrow: binds apis to the services of a Sparrow RPC facet, ops to
// its methods, and the types they reach to the facet's type definitions,
// from the APIs and Data tabs. Sparrow is a CBOR protocol whose payloads
// are read by numbers alone, so this package is mostly about numbers that
// stay put: a field's tag, a type's and a method's id, a sigil's id.
import = ["std/schema@1", "std/types@1", "std/spec@1"]

sparrow: package(version = "1.0", requires = ["std/types@1"]) {
  /// Sparrow's core status codes an error can be answered with, as its
  /// spec names them: gRPC's codes, but ok. The protocol's own codes, from
  /// protocol_error up, are the transport's to send, never an op's.
  Code: enum {
    cancelled: Self
    unknown: Self
    invalid_argument: Self
    deadline_exceeded: Self
    not_found: Self
    already_exists: Self
    permission_denied: Self
    resource_exhausted: Self
    failed_precondition: Self
    aborted: Self
    out_of_range: Self
    unimplemented: Self
    internal: Self
    unavailable: Self
    data_loss: Self
    unauthenticated: Self
  }

  /// On an api, the facet its service belongs to, the facet's version and
  /// id, and the service's name and id; on an op, its method's name and
  /// id, and the hints that it's idempotent or that its result may be
  /// shared between callers. Apis naming one facet share it, as one plugin
  /// publishes several services in one facet.
  sparrow(
    facet?: String,
    version?: String,
    facet_id?: Int,
    service?: String,
    method?: String,
    id?: Int,
    idempotent?: Bool,
    shared?: Bool,
  ): annotation(on = [types.api, types.op])

  /// A member's, parameter's or union variant's tag: its slot in the
  /// struct's array, or its variant tag. Tags start at 0.
  tag(n: Int): annotation(on = [types.member, types.param, types.variant])

  /// A record's, enum's or union's TypeId in its facet, 64 and up.
  id(n: Int): annotation(on = [types.type, types.enum, types.union])

  /// The sigil of an enum value, or of an error without a core code: its
  /// id in the facet, 64 and up.
  sigil(n: Int): annotation(on = [types.variant, types.type, spec.error])

  /// A record encoded as a map from tag to value, absent fields left out,
  /// for types with many optional fields that are usually empty.
  sparse: annotation(on = [types.type])

  /// Tags of fields that were removed and are never reused.
  reserved(tags<variadic>: Int): annotation(on = [types.type, types.union])

  /// Ids that the facet once defined and never defines again, by space.
  retired(types?: List(Int), services?: List(Int), methods?: List(Int), sigils?: List(Int)): annotation(on = [types.api])

  /// The core status code an error is answered with; an error without one
  /// is answered with a sigil of its own.
  code(code: Code): annotation(on = [types.type, spec.error])
}
