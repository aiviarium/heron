// std/project: the implementation side of a detached spec. A spec is a
// package of its own, authored and versioned apart from the code and
// usually sealed; a project imports it at a version and adds only what is
// about its implementation: the components that build the spec's parts,
// the tests that prove its requirements at a revision, where the rest
// stands, its releases, and its delivery: stories, increments and
// milestones. A project refers to the spec and never restates it.
import = ["std/schema@1", "std/types@1", "std/doc@1"]

project: package(version = "1.1", requires = ["std/doc@1"]) {
  /// The spec package this tree implements, at the spec version it
  /// implements (SM.Sm.Sp), copied exactly from the spec package. Declared
  /// at the root, it puts the tree in project mode, which leaves spec kinds
  /// to the spec. `version` is the project's own version, which starts
  /// with the spec version: by default SM.Sm.Sp with optional `+<tag>IB`
  /// build metadata, a label and the implementation build counter, as
  /// `2.1.3+build4` or `2.1.3+rc2`; where `versioning` sets the scheme
  /// `SM.Sm.Sp.IP`, an implementation patch IP follows, as `2.1.3.4+rc2`. Semver gives `+` metadata no precedence, so the build
  /// counter orders two builds of one spec version; it starts again when
  /// the spec version changes, as IP does. `since` is the path of
  /// an earlier version of the spec package, which the conformance report
  /// compares with; `docs` is the base URL of the spec's rendered site,
  /// which links to spec nodes go to.
  implements(spec: Ref(Any), at: String): kind(in = [block]) {
    version?: String
    versioning?: Versioning
    since?: String
    docs?: String
    accept(prose)
  }

  // --- Architecture ---

  /// A unit of the implementation's code with one contract, such as a Go
  /// or TS package, at a path from the repository root. Its references
  /// name the spec's features and parts it builds. Architecture, never a
  /// spec kind.
  component(path: String, refs<variadic>?: Ref(Any), lang?: String): kind(in = [block], references = [spec.feature, spec.part]) {
    /// The components it may import; any other import breaks the contract.
    uses?: List(Ref(component))
    accept(prose)
    accept(kind = responsibility)
    accept(kind = exports)
    accept(kind = property)
    accept(category = block)
    accept(kind = verify)
  }

  /// A property a component holds at every call, with the tests that
  /// verify it: architecture's contract, never a spec's rule.
  property: kind(in = [block]) {
    accept(prose)
    accept(category = spec.strength, max = 1)
    accept(kind = verify)
  }

  /// One thing a component owns.
  responsibility: kind {
    accept(prose)
  }

  /// Part of the exported interface of a component, as code in the
  /// component's language unless `lang` names another; `title` names the
  /// file or group it comes from.
  exports(lang?: String, title?: String): kind {
    accept(text = Verbatim)
  }

  /// Links spec requirements (rules, scenarios, use cases, errors or
  /// contract entries) to the tests that prove them, by the spec's paths,
  /// at the revision the core's `@rev` names (1 when left out). Several
  /// proofs may name one requirement.
  proves(requirements<variadic>: Ref(Any)): kind(in = [block, revised]) {
    accept(prose)
    accept(kind = verify)
  }

  /// The test or script that proves the requirements of the proof it
  /// stands in: a file, relative to the repository's root, and the test or
  /// step in it. Test links live only here, on the implementation's side;
  /// no spec kind takes one.
  verify(path: String, test?: String): kind {
    accept(prose)
  }

  /// Where spec requirements stand in this project while no test proves
  /// them: `<planned>` when they aren't built yet, `<untested>` when they
  /// are built and no test proves them yet. A requirement no proof names
  /// and no progress covers is missing.
  progress(requirements<variadic>: Ref(Any)): kind(in = [block]) {
    accept(prose)
  }

  /// Not built yet; on a story, an increment or a milestone, not started.
  planned: flag(on = [progress, story, increment, milestone], group = "implementation_status")
  /// Built, with no test proving it yet.
  untested: flag(on = [progress], group = "implementation_status")

  /// A release of the project at a version of its scheme, recorded by the
  /// git tag `v<version>`, as `v2.1.3+build4`.
  release(version: String, date?: String): kind(in = [block]) {
    accept(prose)
  }

  // --- Delivery ---

  /// One change to the spec, small enough to build in one increment: its
  /// references name the goals it advances, `adds` and `changes` the spec
  /// items it adds and changes. It states no behaviour; its `done` holds
  /// what delivery alone needs.
  story(refs<variadic>?: Ref(Any), adds?: List(Ref(Any)), changes?: List(Ref(Any))): kind(in = [block], references = [spec.goal, spec.quality]) {
    accept(prose)
    accept(kind = done, max = 1)
  }

  /// A shippable slice of the system that delivers stories.
  increment(delivers<variadic>?: Ref(Any)): kind(in = [block]) {
    accept(prose)
    accept(kind = done, max = 1)
    accept(category = block)
  }

  /// A point in time the work is measured against.
  milestone(reached_by<variadic>?: Ref(Any)): kind(in = [block]) {
    accept(prose)
    accept(kind = done, max = 1)
  }

  /// What done means for its parent, beyond its spec items being proven.
  done: kind(in = [block]) {
    accept(prose)
  }

  /// Where a piece of delivery work stands.
  started: flag(on = [story, increment, milestone], group = "status")
  delivered: flag(on = [story, increment, milestone], group = "status")
  deferred: flag(on = [story, increment, milestone], group = "status")
}
