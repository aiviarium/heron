// std/http: binds apis and ops to HTTP, with server-sent events for
// streamed results, from the Schemas and APIs tabs.
import = ["std/schema@1", "std/types@1", "std/spec@1"]

http: package(version = "1.0", requires = ["std/types@1"]) {
  get: flag(group = "method", on = [http])
  post: flag(group = "method", on = [http])
  put: flag(group = "method", on = [http])
  patch: flag(group = "method", on = [http])
  delete: flag(group = "method", on = [http])

  /// The base path of an api, or the method flag and path of an op,
  /// with path parameters written :name.
  http(path?: String, base_path?: String): annotation(on = [types.api, types.op])

  path: annotation(on = [types.param])
  query: annotation(on = [types.param])
  header(name?: String): annotation(on = [types.param])
  body: annotation(on = [types.param])

  /// The status code an error is returned with: on a type that implements
  /// Error, or on a spec error, its projection on an API.
  status(code: Int): annotation(on = [types.type, spec.error])
}
