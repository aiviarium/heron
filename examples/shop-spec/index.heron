// A sample detached spec: the shop's checkout, authored and versioned on
// its own and sealed, so the projects that implement it import it and
// refer to its nodes but can't amend them. examples/shop implements it.
import = ["std/schema@1", "std/doc@1"]

/// The shop's checkout: who buys, the system's parts and what paying must do.
shop: package(version = "2.1.3", sealed = true) {
  /// Someone who buys from the shop.
  buyer: actor {{ A person with a cart who pays for an order. }}

  /// The parts of the system the requirements are about.
  parts: section {
    cart: part {{ Holds what the buyer is about to order. }}

    payments: part {{ Takes the buyer's money for an order. }}
  }

  checkout: feature(buyer) {
    | Paying for an order and what the buyer gets back.

    pay_once: rule {
      must {{ charge an order at most once, however often the buyer submits it }}
    }

    receipt: rule {
      must {{ send the buyer a receipt once an order is paid }}
    }

    refund_window: rule {
      should {{ refund an order on request within 14 days of payment }}
    }

    empty_cart: rule {
      must_not {{ start a checkout for an empty cart }}
    }

    paid: scenario(checkout.pay_once) {
      given {{ a cart with one item }}
      when {{ the buyer pays }}
      then {{ the order is paid and the cart is empty }}
    }
  }
}
