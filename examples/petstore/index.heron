// The Example tab's pet store, as far as unit 1 reaches: the stages, the
// checks pipeline, scenarios, resources, agents and the changelog belong to
// units 3 and 4, so their files and the includes of them are left out, and
// `repository` comes from std/repo until std/ci provides it.
import = [
  "std/doc@1",
  "std/types@1",
  "std/process@1",
  "std/json@1",
  "std/repo@1",
  "std/docs@1",
  "std/lint@1",
]

include = [
  "./projects.heron",
  "./specs/store/index.heron",
  "./services/store/tasks.heron",
]

// Prose linting: Vale with the repository's styles and vocabulary, and
// the spec-aware prose lints std/lint turns on.
lint {
  vale {
    config = "./.vale.ini"
    min_level = "warning"

    // Vale's scopes, applied to the projected document.
    skip = ["code"]
  }
}

repository {
  toolchain = { node = "22", pnpm = "10" }

  /// Checks the toolchain, or installs it when asked, then pins and installs
  /// the packages and sources, installs the workspace and writes the
  /// generated files.
  setup(install_toolchain: Bool = false, update: Bool = false): task do {
    ensure_toolchain(repository.toolchain, install = install_toolchain)
    install_packages(update = update)
    run("pnpm", args = ["install"])
    generate()
  }
}

// How the docs are generated, as the Development tools tab's Styling
// shows: the store api in the reference's layout, the orders as a landing
// page, and a word in every page's sidebar and after every rule.
docs {
  layout("api") {
    sections = [store]
  }

  layout("landing") {
    sections = [orders]
  }

  slot("sidebar") {
    | Questions about the store go to the store team.
  }

  slot("after", of = spec.rule) {
    | A rule that changes bumps the store spec's version.
  }
}
