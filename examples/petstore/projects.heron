/// The whole product: the repository, the root project.
petstore: project(path = ".") {
  members = [store_spec, store_svc, shared_types]
}

/// The store spec.
store_spec: project(path = "specs/store") {}

store_svc: project(path = "services/store") {
  implements = [store]
  paths = { orders = "src/orders/**" }
  depends_on = [shared_types, mailer]
}

shared_types: project(path = "packages/types") {}

mailer: project<external>(path = "vendor/mailer") {
  source = git("https://github.com/petstore/mailer", ref = "v1.8.0")
}
