@http(base_path = "/v2")
store: api {
  @http<post>("/pets")
  add_pet(@body pet: Pet): op(Pet)

  @http<get>("/pets/:pet_id")
  @throws(PetNotFound)
  get_pet(@path pet_id: Int): op(Pet)

  @http<get>("/pets/find_by_status")
  find_by_status(
    @query status: List(PetStatus),
    @query cursor?: String,
  ): op(Page(Pet))

  @realizes(orders.ordering.hold_on_order, orders.ordering.only_available)
  @http<post>("/store/orders")
  @throws(StoreError)
  @performs(orders.pet_lifecycle.held)
  place_order(@body request: OrderRequest): op(Order) {
    | Places an order for an [available](#orders.available) pet, subject to the [ordering rules](#orders.ordering).

    available_pet: example {
      request = OrderRequest(pet_id = 10)
      returns = Order(id = 1, pet_id = 10, status = OrderStatus.PLACED)
    }

    sold_pet: example {
      request = OrderRequest(pet_id = 11)
      throws = PetNotAvailable
    }
  }

  @http<post>("/store/orders/:order_id/approve")
  @throws(OrderNotFound)
  @performs(orders.pet_lifecycle.sold)
  approve_order(@path order_id: Int): op(Order)

  @realizes(orders.ordering.cancel_releases, orders.ordering.delivered_stays)
  @http<delete>("/store/orders/:order_id")
  @throws(StoreError)
  @performs(orders.pet_lifecycle.released)
  cancel_order(@path order_id: Int): op(Order)
}
