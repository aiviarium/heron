Audited: interface {
  created_at: Timestamp
  created_by: String = "system"
}

Category: type {
  id: Int
  name: String
}

@touch(orders.single_sale)
Pet: type(Audited) {
  id: Int
  name: String
  category?: Category
  /// Where the pet's photos are served from.
  photo_urls: List(String)
  tags: List(String) = []
  status: PetStatus
}

PetStatus: enum {
  AVAILABLE: Self
  PENDING: Self
  SOLD: Self
}

/// An order for one pet, placed through the store.
Order: type(Audited) {
  id: Int
  pet_id: Int
  ship_date?: Timestamp
  status: OrderStatus
}

OrderStatus: enum {
  PLACED: Self
  APPROVED: Self
  DELIVERED: Self
  CANCELLED: Self
}

OrderRequest: type {
  pet_id: Int
  /// A missing date ships the pet as soon as the order is approved.
  ship_date?: Timestamp
}

/// Everything the store can refuse a request with; each error below
/// extends it, so `@throws(StoreError)` covers them all.
StoreError: error(400) {
  title = "The store can't do this."
}

PetNotFound: error(StoreError, 404) {
  title = "No pet exists with the id {pet_id}."
  pet_id: Int
}

PetNotAvailable: error(StoreError, 409) {
  title = "The pet is {status}, not available for sale."
  status: PetStatus
}

OrderNotFound: error(StoreError, 404) {
  title = "No order exists with the id {order_id}."
  order_id: Int
}

OrderNotCancellable: error(StoreError, 409) {
  title = "A delivered order can't be cancelled."
}

Page(T: Any): type {
  items: List(T)
  next?: String
}
