// A sample project that implements the detached shop spec: it imports the
// sealed spec package at its version and adds only what is about the
// implementation, its components, the tests that prove the spec's
// requirements, where the rest stands, and its releases.
import = [
  "std/doc@1",
  "std/spec@1",
  "std/tech@1",
  "std/project@1",
  "../shop-spec/",
]

/// The shop's web store, built against the checkout spec.
store: implements(shop, at = "2.1.3") {
  version = "2.1.3+build2"
  since = "../shop-spec-2.1.2/"

  | The store implements the shop's checkout spec at 2.1.3. Its versions start with the spec
  | version, and the build counter after `+` counts its releases of that spec version.
}

architecture: section {
  | How the store is built: one component per Go package.

  /// The cart a buyer fills before checking out.
  @realizes(shop.parts.cart, shop.buyer)
  cart: component("internal/cart", lang = "go") {
    responsibility {{ Holds the items of a buyer's cart until checkout. }}
  }

  /// Payment through the payment provider.
  @realizes(shop.parts.payments)
  payments: component("internal/payments", lang = "go") {
    uses = [cart]

    responsibility {{ Charges an order and records that it is paid. }}
  }
}

proofs: section {
  | The tests that prove the spec's requirements, and where the rest stands.

  proves(shop.checkout.pay_once) {
    verify("internal/payments/charge_test.go", test = "TestChargeOnce")
  }

  proves(shop.checkout.pay_once, shop.checkout.receipt) {
    verify("scripts/e2e-checkout.sh", test = "pay twice")
  }

  proves(shop.checkout.pay_story.paid) {
    verify("internal/cart/checkout_test.go", test = "TestPayEmptiesCart")
  }

  refunds_later: status<planned>(shop.checkout.refund_window) {{ Refunds come with the provider's refund API. }}
}

history: section {
  | What the store has shipped, each release tagged in git.

  first: release("2.1.3+build1", date = "2026-11-02") {{ The first release against the 2.1.3 spec. }}

  second: release("2.1.3+build2", date = "2026-11-20") {{ Receipts by email. }}
}
