// The parcels service's types and errors. Parcel numbers its fields for
// protobuf and tags them for Sparrow, so they stay put when it grows; the
// others are numbered and tagged in the order their fields are written, and
// every type takes its Sparrow TypeId in the order the facet reaches it.

/// A parcel as the network tracks it.
@proto.reserved(4)
@sparrow.reserved(3)
Parcel: type {
  @field(1)
  @tag(0)
  id: String
  @field(2)
  @tag(1)
  status: ParcelStatus
  /// What the parcel weighs, as the depot's scale read it.
  @field(3)
  @tag(2)
  weight_grams: Int(bits = 32)
  /// Where the parcel goes; left out until it's addressed.
  @field(5)
  @tag(4)
  destination?: Destination
  /// Handling notes printed on the label, such as fragile.
  @field(6)
  @tag(5)
  labels: Map(String, String) = {}
}

/// Where a parcel is in its life.
ParcelStatus: enum {
  LABELLED: Self
  IN_TRANSIT: Self
  DELIVERED: Self
  /// The courier couldn't deliver it, and it's on its way back.
  RETURNED: Self
}

/// A street address or a parcel locker.
Destination: union {
  address: Address
  locker: Locker
}

Address: type {
  street: String
  postal_code: String
  city: String
  /// An ISO 3166 country code, such as DE.
  country: String
}

Locker: type {
  /// The locker's code, printed on its door.
  code: String
}

/// What a label is printed from.
LabelRequest: type {
  weight_grams: Int(bits = 32)
  destination: Destination
}

/// Something that happened to a parcel.
ParcelEvent: type {
  status: ParcelStatus
  /// Where it happened.
  place: String
  at?: Timestamp
}

/// One read of a parcel's label by a depot's sorter.
Scan: type {
  parcel_id: String
  depot: String
  at?: Timestamp
}

ScanSummary: type {
  /// The scans that matched a parcel.
  accepted: Int
}

/// A courier's position.
Position: type {
  lat: Float
  lng: Float
}

/// The next step of a courier's route.
Instruction: type {
  text: String
  /// How far ahead the step is.
  meters: Int(bits = 32)
}

@status(404)
@proto.code(NOT_FOUND)
@jsonrpc.code(-32004)
@sparrow.code(not_found)
ParcelNotFound: type(Error) {
  message: String = "No parcel has this id."
  id: String = ""
}

@status(422)
@proto.code(INVALID_ARGUMENT)
@jsonrpc.code(-32010)
// Sparrow answers it with a sigil of its own rather than invalid_argument,
// so a client tells it from any other bad input.
@sigil(80)
InvalidAddress: type(Error) {
  message: String = "The address can't be delivered to."
  /// The field of the address that's wrong.
  field: String = ""
}

@status(503)
@proto.code(UNAVAILABLE)
@jsonrpc.code(-32011)
@sparrow.code(unavailable)
RouteUnavailable: type(Error) {
  message: String = "No route can be planned right now; retry shortly."
}
