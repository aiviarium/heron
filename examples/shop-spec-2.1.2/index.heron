// The sample shop spec as it was at 2.1.2, the earlier version
// examples/shop's conformance report compares with.
import = ["std/schema@1", "std/doc@1"]

/// The shop's checkout: who buys, the system's parts and what paying must do.
shop: package(version = "2.1.2", sealed = true) {
  /// Someone who buys from the shop.
  buyer: actor {{ A person with a cart who pays for an order. }}

  /// The parts of the system the requirements are about.
  parts: section {
    cart: section {{ Holds what the buyer is about to order. }}

    payments: section {{ Takes the buyer's money for an order. }}
  }

  checkout: section {
    | Paying for an order and what the buyer gets back.

    pay_once: rule {
      must {{ charge an order at most once, however often the buyer submits it }}
    }

    receipt: rule {
      must {{ send the buyer a receipt }}
    }

    refund_window: rule {
      should {{ refund an order on request within 14 days of payment }}
    }

    pay_later: rule {
      may {{ let a buyer pay for an order a month after it ships }}
    }

    paid: scenario(checkout.pay_once) {
      given {{ a cart with one item }}
      when {{ the buyer pays }}
      then {{ the order is paid and the cart is empty }}
    }
  }
}
